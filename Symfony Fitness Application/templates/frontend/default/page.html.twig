{% extends 'layout.html.twig' %}

{% block title %}{{ page.metaTitle }} {{ parent() }} {% endblock %}

{% set route = app.request.attributes.get('_route') %}

{% block content %}
    {% if page %}
        <main class="{{ page.classes }}">
            {% for section in page.pageSections %}
                {% include 'frontend/default/partials/' ~ page.machineName ~ '/' ~ section.template ignore missing %}
            {% endfor %}

            {% if route not in ['app_certificates', 'app_education_register', 'app_login', 'app_register', 'app_team', 'app_contact', 'app_educations', 'app_blog', 'app_privacy_policy', 'app_terms'] %}
                {% include "frontend/default/partials/common/newsletter.html.twig" %}
            {% endif %}
        </main>
    {% endif %}
{% endblock %}

{% block page_javascripts %}
    <script>

        console.log(window.countyCitiesPath);

        if (document.querySelector('.counties') && document.querySelector('.cities')) {
            let county = $('.counties');
            let city = $('.cities');

            county.on('change', function () {
                $.ajax({
                    method: "GET",
                    url: window.countyCitiesPath,
                    data: {'id': $(this).val()},
                    cache: false,
                    success: function (response) {

                        city.empty();

                        let optionTpl = `<option value="{id}">{name}</option>`;
                        if (response.status) {
                            response.cities.forEach(function (item) {
                                let newTpl = optionTpl.replace('{name}', item.name)
                                    .replace('{id}', item.id)
                                    .replace('{name}', item.name);
                                $(newTpl).appendTo(city);
                            });
                        }
                    }
                });
            });
        }
    </script>
{% endblock %}