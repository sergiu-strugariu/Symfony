<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}| MoveOn{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/ico" href="{{ asset('assets/frontend/favicon.ico') }}"/>
        {% block stylesheets %}{% endblock %}
        {% block meta_og %}{% endblock %}
        <script src='https://www.google.com/recaptcha/api.js'></script>

        <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
        <script>
            window.OneSignalDeferred = window.OneSignalDeferred || [];
            OneSignalDeferred.push(async function(OneSignal) {
                await OneSignal.init({
                    appId: "{{ onesignal_app_id }}",
                    safari_web_id: "{{ onesignal_safari_web_id }}",
                    notifyButton: {
                        enable: true,
                    },
                });
            });
        </script>

        <!-- Google Consent Mode -->
        <script data-cookieconsent="ignore">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments)
            }
            gtag("consent", "default", {
                ad_personalization: "denied",
                ad_storage: "denied",
                ad_user_data: "denied",
                analytics_storage: "denied",
                functionality_storage: "denied",
                personalization_storage: "denied",
                security_storage: "granted",
                wait_for_update: 500
            });
            gtag("set", "ads_data_redaction", true);
            gtag("set", "url_passthrough", true);
        </script>
        <!-- End Google Consent Mode-->

        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=GQ5X554M2B5" data-cookieconsent="ignore"></script>
        <script data-cookieconsent="ignore">
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-Q5X554M2B5');
        </script>
    </head>
    <body>
        {% block body %}
        {% endblock %}
        {% block javascripts %}
        {% endblock %}
        {% block page_javascripts %}
        {% endblock %}
        {% block intercom %}
        {% endblock %}
    </body>
</html>
