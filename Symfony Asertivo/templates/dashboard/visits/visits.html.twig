{% extends 'layout.html.twig' %}

{% block title %}Lista vizite {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-4">
            {% include 'dashboard/shared/tabs.html.twig' %}
            <!--begin::Wrapper-->
            <div class="d-flex flex-stack my-5">
                <!--begin::Search-->
                <div class="my-2 me-3">
                    <input type="text" data-kt-visits-table-filter="search"
                           class="form-control form-control-solid w-250px ps-15" placeholder="Cauta..."/>
                </div>
                <!--end::Search-->
                {% if not is_granted('ROLE_MEDIC') %}
                    <div class="my-2 me-3">
                        <select name="filter_type" class="form-select form-select-solid w-200px ps-4 d-inline-block">
                            <option value="">Filtrează</option>
                            {% for key, item in visitTypes %}
                                <option value="{{ key }}">{{ item }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>
            <!--end::Wrapper-->
            <!--begin::Datatable-->
            <table id="kt_datatable_visits" class="table align-middle table-row-dashed fs-6 gy-5">
                <thead>
                <tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                    <th>Data</th>
                    <th>Ora</th>
                    <th>Nume</th>
                    <th>Apartinator</th>
                    <th>Observatii</th>
                    <th>Status</th>
                </tr>
                </thead>
                <tbody class="text-gray-600 fw-semibold">
                </tbody>
            </table>
            <!--end::Datatable-->
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTDatatablesRelationVisits.init();
        });
    </script>
{% endblock %}