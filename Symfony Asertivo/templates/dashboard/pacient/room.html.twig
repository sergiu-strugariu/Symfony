{% extends 'layout.html.twig' %}

{% block title %}Camera {{ pacient.name }} {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}

    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-4">
            {% include 'dashboard/shared/breadcrumbs.html.twig' %}
            {% include 'dashboard/pacient/_pacient_tabs.html.twig' %}

            <!--begin::Header-->
            <div class="card-header border-0 pt-5">
                <div class="card-title align-items-start flex-column"></div>
                <div class="card-toolbar">
                    <a href="#" class="btn btn-sm btn-light btn-active-primary" data-bs-toggle="modal" data-bs-target="#kt_modal_assign_pacient_room" data-pacient-uuid="{{ pacient.uid }}">
                        <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                        <span class="svg-icon svg-icon-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="currentColor" />
                                <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="currentColor" />
                            </svg>
                        </span>
                        <!--end::Svg Icon-->
                        Asociaza camera
                    </a>
                </div>
            </div>
            <!--end::Header-->
            <!--begin::Body-->
            <div class="card-body">
                <!--begin::Table container-->
                <div class="table-responsive">
                    <!--begin::Table-->
                    <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <!--begin::Table head-->
                        <thead>
                            <tr class="fw-bold text-muted">
                                <th>Nr camera</th>
                                <th>Data</th>
                                <th>Detalii</th>
                            </tr>
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody>
                            {% for room in rooms %}
                                <tr>
                                    <td>
                                        <span class="text-dark fw-bold fs-6">{{ room.nursingHomeRoom.roomNumber }}</span>
                                    </td>
                                    <td>
                                        <span class="text-dark fw-bold fs-6">{{ room.createdAt|date('d/m/Y') }}</span>
                                    </td>
                                    <td>
                                        <span class="text-dark fw-bold fs-6">{{ room.observations|default('-') }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Table container-->
            </div>
            <!--begin::Body-->
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block modals %}
    {% include 'dashboard/shared/modal/assign_pacient_room.html.twig' %}
    {% include 'dashboard/shared/toast/default.html.twig' %}
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTPacientRoom.init();
        });
    </script>
{% endblock %}
