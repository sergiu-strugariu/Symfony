                        <!--begin::Col-->
                        <div class="col-lg-9 fv-row">
                            {{ form_widget(form.treatment, {'attr': {'class': 'form-control form-control-lg form-control-solid', 'placeholder': 'Tratament', 'rows': '3'}}) }}
                        </div>
                        <!--end::Col-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="row mb-6">
                        <!--begin::Label-->
                        {{ form_label(form.estimatedAdmissionDate, 'Data posibila de internare', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                        <!--end::Label-->
                        <!--begin::Col-->
                        <div class="col-lg-9 fv-row">
                            {{ form_widget(form.estimatedAdmissionDate, {'attr': {'class': 'form-control form-control-lg form-control-solid datepicker', 'placeholder': 'Data posibila de internare'}}) }}
                        </div>
                        <!--end::Col-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="row mb-6">
                        <!--begin::Label-->
                        {{ form_label(form.observations, 'Observatii', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                        <!--end::Label-->
                        <!--begin::Col-->
                        <div class="col-lg-9 fv-row">
                            {{ form_widget(form.observations, {'attr': {'class': 'form-control form-control-lg form-control-solid', 'placeholder': 'Observatii', 'rows': '3'}}) }}
                        </div>
                        <!--end::Col-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Separator-->
                    <div class="separator separator-content my-15"><span class="w-250px h2">Date lead</span></div>
                    <!--end::Separator-->
                    <!--begin::Input group-->
                    <div class="row mb-6">
                        <!--begin::Label-->
                        {{ form_label(form.scheduledAt, 'Vizionare programata', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                        <!--end::Label-->
                        <!--begin::Col-->
                        <div class="col-lg-9 fv-row">
                            {{ form_widget(form.scheduledAt, {'attr': {'class': 'form-control form-control-lg form-control-solid datetimepicker', 'placeholder': 'Vizionare programata'}}) }}
                        </div>
                        <!--end::Col-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="row mb-6">
                        <!--begin::Label-->
                        {{ form_label(form.offerSentAt, 'Oferta trimisa', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                        <!--end::Label-->
                        <!--begin::Col-->
                        <div class="col-lg-9 fv-row">
                            {{ form_widget(form.offerSentAt, {'attr': {'class': 'form-control form-control-lg form-control-solid datetimepicker', 'placeholder': 'Oferta trimisa'}}) }}
                        </div>
                        <!--end::Col-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="row mb-6">
                        <!--begin::Label-->
                        {{ form_label(form.status, 'Status', {'label_attr': {'class': 'required col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                        <!--end::Label-->
                        <!--begin::Col-->
                        <div class="col-lg-9 fv-row">
                            {{ form_widget(form.status, {'attr': {'data-control': 'select2', 'data-placeholder': 'Selecteaza o optiune...', 'class': 'form-select form-select-solid form-select-lg fw-semibold'}}) }}
                        </div>
                        <!--end::Col-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="row mb-6">
                        <!--begin::Label-->
                        {{ form_label(form.leadSource, 'Sursa lead', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                        <!--end::Label-->
                        <!--begin::Col-->
                        <div class="col-lg-9 fv-row">
                            {{ form_widget(form.leadSource, {'attr': {'data-control': 'select2', 'data-placeholder': 'Selecteaza o optiune...', 'class': 'form-select form-select-solid form-select-lg fw-semibold'}}) }}
                        </div>
                        <!--end::Col-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="row mb-6">
                        <!--begin::Label-->
                        {{ form_label(form.leadSourceComment, 'Comentarii sursa lead', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                        <!--end::Label-->
                        <!--begin::Col-->
                        <div class="col-lg-9 fv-row">
                            {{ form_widget(form.leadSourceComment, {'attr': {'class': 'form-control form-control-lg form-control-solid', 'placeholder': 'Comentarii sursa lead', 'rows': '3'}}) }}
                        </div>
                        <!--end::Col-->
                    </div>
                    <!--end::Input group-->
                </form>
            </div>
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block modals %}
    {% include 'dashboard/shared/toast/default.html.twig' %}
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTPacientProspect.init('{{ pacient.uid }}');
        });
    </script>
{% endblock %}



