                                {{ form_label(form.requiresMedicalBed, ' ', {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>
                        <!--begin::Label-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="row mb-6">
                        <!--begin::Label-->
                        {{ form_label(form.treatment, 'Tratament', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
