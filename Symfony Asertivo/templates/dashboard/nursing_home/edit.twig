{% extends 'layout.html.twig' %}

{% block title %}Date {{ nursingHome.name }} {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-4">
            {% include 'dashboard/nursing_home/_nursing_home_tabs.html.twig' %}
            <div class="py-10 px-9">
                <form id="kt_modal_add_nursing_home_form" class="form" method="post">
                    {% include 'dashboard/nursing_home/__nursing_home_form.html.twig' %}
                    <!--begin::Actions-->
                    <div class="d-flex justify-content-end pt-15">
                        <button type="reset" class="btn btn-light me-3" data-kt-nursing-home-modal-action="cancel">
                            Renunță
                        </button>
                        <button type="submit" class="btn btn-primary" data-kt-nursing-home-modal-action="submit">
                            <span class="indicator-label">Salvează</span>
                            <span class="indicator-progress">Se încarcă...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </span>
                        </button>
                    </div>
                    <!--end::Actions-->
                </form>
            </div>
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}
{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTUtilities.initCounties();
        });
    </script>
{% endblock %}
