{% extends 'layout.html.twig' %}

{% block title %}Status dosare digitale per pacient {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-10 px-10">
            <!--begin::Wrapper-->
            <div class="d-flex flex-stack my-5">
                <!--begin::Form-->
                <form action="" method="GET">
                    <div class="d-flex align-items-center position-relative my-1">
                        <div class="my-2 me-3">
                            <select name="nursing-home" data-control="select2" class="form-select form-select-solid form-select-lg me-4">
                                <option value="">Alege un cămin</option>
                                {% for item in nursingHomes %}
                                    <option value="{{ item.uid }}" {{ selectedNursingHome == item.uid ? 'selected' : '' }}>
                                        {{ item.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="my-2 me-3">
                            <select name="floor" data-control="select2" class="form-select form-select-solid form-select-lg me-4">
                                <option value="">Alege un etaj</option>
                                {% for floor in floors %}
                                    <option value="{{ floor }}" {{ selectedFloor == floor ? 'selected' : '' }}>{{ floor }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="my-2 me-3">
                            <select name="room_id" data-control="select2" class="form-select form-select-solid form-select-lg me-4">
                                <option value="">Alege o camera</option>
                                {% for room in rooms %}
                                    <option value="{{ room.id }}" {{ selectedRoomId == room.id ? 'selected' : '' }}>{{ room.roomNumber }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="my-2 me-3">
                            <select name="status" data-control="select2" class="form-select form-select-solid form-select-lg me-4">
                                <option value="">Alege un status</option>
                                {% for key, status in statuses %}
                                    <option value="{{ key }}" {{ selectedStatus == key ? 'selected' : '' }}>{{ status }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="my-2">
                            <button type="submit" class="btn btn-primary">
                                Filtreaza
                            </button>
                        </div>
                    </div>
                </form>
                <!--end::Form-->
                <!--begin::Toolbar-->
                <div class="d-flex justify-content-end" data-kt-nursing-home-table-toolbar="base">
                    <!--begin::Export report -->
                    <a href="{{ path('digital_records_report_export') }}" class="btn btn-primary">
                        <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                        <span class="svg-icon svg-icon-2"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21 22H3C2.4 22 2 21.6 2 21C2 20.4 2.4 20 3 20H21C21.6 20 22 20.4 22 21C22 21.6 21.6 22 21 22ZM13 13.4V3C13 2.4 12.6 2 12 2C11.4 2 11 2.4 11 3V13.4H13Z" fill="currentColor"/>
                            <path opacity="0.3" d="M7 13.4H17L12.7 17.7C12.3 18.1 11.7 18.1 11.3 17.7L7 13.4Z" fill="currentColor"/>
                            </svg></span>
                        <!--end::Svg Icon-->       
                        Exporta raport
                    </a>
                    <!--end::Export report -->
                </div>
                <!--end::Toolbar-->
            </div>
            {% set totalDocumentsCount = 0 %}
            {% set uploadedDocumentsCount = 0 %}
            {% set waitingDocumentsCount = 0 %}
            <!--end::Wrapper-->
            <table class="table table-row-bordered table-row-gray-300 align-middle gs-0 gy-4">
                <tr>
                    <td class="text-dark fw-bold fs-6">Nr crt</td>
                    <td class="text-dark fw-bold fs-6">Nume pacient</td>
                    <td class="text-dark fw-bold fs-6">Etaj/Camera</td>
                    <td class="text-dark fw-bold fs-6">Status</td>
                    <td class="text-dark fw-bold fs-6">Documente total</td>
                    <td class="text-dark fw-bold fs-6">Documente incarcate</td>
                    <td class="text-dark fw-bold fs-6">Documente lipsa</td>
                    <td class="text-dark fw-bold fs-6">Progres</td>
                    <td class="text-dark fw-bold fs-6">Actiuni</td>
                </tr>
                {% for row in data %}
                    <tr>
                        <td class="fw-semibold fs-6">{{ loop.index }}</td>
                        <td class="fw-semibold fs-6"><a href="{{ path('dashboard_pacient_digital_record', {'uuid': row['uuid']}) }}" target="_blank">{{ row['name'] }}</a></td>
                        <td class="fw-semibold fs-6">{{ row['floor'] ~ ' - ' ~ row['roomNumber'] }}</td>
                        <td class="fw-semibold fs-6">{{ row['status'] }}</td>
                        <td class="fw-semibold fs-6">{{ row['totalDocumentsCount'] }}</td>
                        <td class="fw-semibold fs-6">{{ row['uploadedDocumentsCount'] }}</td>
                        <td class="fw-semibold fs-6">{{ row['waitingDocumentsCount'] }}</td>
                        <td class="fw-semibold fs-6">{{ row['progress'] }}%</td>
                        <td>
                            <a href="#" class="btn btn-light btn-active-light-primary btn-sm" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end" data-kt-menu-flip="top-end">
                                Actiuni
                                <span class="svg-icon svg-icon-5 m-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                    <polygon points="0 0 24 0 24 24 0 24"></polygon>
                                    <path d="M6.70710678,15.7071068 C6.31658249,16.0976311 5.68341751,16.0976311 5.29289322,15.7071068 C4.90236893,15.3165825 4.90236893,14.6834175 5.29289322,14.2928932 L11.2928932,8.29289322 C11.6714722,7.91431428 12.2810586,7.90106866 12.6757246,8.26284586 L18.6757246,13.7628459 C19.0828436,14.1360383 19.1103465,14.7686056 18.7371541,15.1757246 C18.3639617,15.5828436 17.7313944,15.6103465 17.3242754,15.2371541 L12.0300757,10.3841378 L6.70710678,15.7071068 Z" fill="currentColor" fill-rule="nonzero" transform="translate(12.000003, 11.999999) rotate(-180.000000) translate(-12.000003, -11.999999)"></path>
                                    </g>
                                    </svg>
                                </span>
                            </a>
                            <!--begin::Menu-->
                            <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-bold fs-7 w-250px py-2" data-kt-menu="true">
                                <!--begin::Menu item-->
                                <div class="menu-item px-3">
                                    <a href="{{ path('dashboard_pacients_discharge_wizard', {'step': 1, 'cnp': row['cnp']}) }}" class="menu-link px-3">
                                        Externare
                                    </a>
                                </div>
                                <!--end::Menu item-->
                                <!--begin::Menu item-->
                                <div class="menu-item px-3">
                                    <a href="" class="menu-link px-3" data-pacient-uuid="{{ row['uuid'] }}" data-kt-pacient="delete">
                                        Arhivare
                                    </a>
                                </div>
                                <!--end::Menu item-->
                            </div>
                            <!--end::Menu-->
                        </td>
                    </tr>
                    {% set totalDocumentsCount = totalDocumentsCount + row['totalDocumentsCount'] %}
                    {% set uploadedDocumentsCount = uploadedDocumentsCount + row['uploadedDocumentsCount'] %}
                    {% set waitingDocumentsCount = waitingDocumentsCount + row['waitingDocumentsCount'] %}
                {% endfor %}
                {% set totalProgress = totalDocumentsCount > 0 ? ((uploadedDocumentsCount * 100) / totalDocumentsCount)|round(0, 'ceil') : 0 %}
                <tr>
                    <td class="fw-semibold fs-6"></td>
                    <td class="fw-semibold fs-6"></td>
                    <td class="fw-semibold fs-6"></td>
                    <td class="fw-semibold fs-6"></td>
                    <td class="fw-semibold fs-6">{{ totalDocumentsCount }}</td>
                    <td class="fw-semibold fs-6">{{ uploadedDocumentsCount }}</td>
                    <td class="fw-semibold fs-6">{{ waitingDocumentsCount }}</td>
                    <td class="fw-semibold fs-6">{{ totalProgress }}%</td>
                    <td class="fw-semibold fs-6"></td>
                </tr>
            </table>
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTReports.init();
        });
    </script>
{% endblock %}