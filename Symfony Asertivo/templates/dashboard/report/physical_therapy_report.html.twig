{% extends 'layout.html.twig' %}

{% block title %}Raport kinetoterapie {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-10 px-10">
            <!--begin::Wrapper-->
            <div class="my-5 d-print-none">
                <div class="d-flex justify-content-between">
                    <!--begin::Form-->
                    <form action="" method="get">
                        <div class="d-flex justify-content-left">
                            <div class="me-2">
                                <input name="date" class="form-control form-control-solid monthpicker"
                                       value="{{ month }}"
                                />
                            </div>
                            <div class="me-3">
                                <select name="nursing-home" data-control="select2" class="form-select form-select-solid form-select-lg me-4">
                                    <option value="">Alege un cămin</option>
                                    {% for item in nursingHomes %}
                                        <option value="{{ item.uid }}" {{ selectedNursingHome == item.uid ? 'selected' : '' }}>
                                            {{ item.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="me-2">
                                <select name="uuid" data-control="select2" class="form-select form-select-solid form-select-lg">
                                    <option value="">Alege un pacient</option>
                                    {% for pacient in pacients %}
                                        <option value="{{ pacient['uid'] }}" {{ pacientUuid == pacient['uid'] ? 'selected' : '' }}>{{ pacient['name'] }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="me-2">
                                <button type="submit" class="btn btn-primary d-inline-block">
                                    Filtrează
                                </button>
                            </div>
                        </div>
                    </form>
                    <!--end::Form-->
                    <div class="me-2">
                        <button type="button" class="btn btn-primary d-inline-block mx-3" onclick="window.print();">
                            Printează
                        </button>
                    </div>
                </div>
            </div>
            <!--end::Wrapper-->
            <div class="my-5">
                <div class="table-responsive">
                    <table class="table table-row-bordered table-row-gray-300 align-middle gs-0 gy-4">
                        <tr>
                            <td class="text-dark fw-bold border-end fs-6">Proceduri de kinetoterapie</td>
                            {% for i in startDay..endDay %}
                                <td class="text-dark fw-bold border-end fs-6">{{ i }}</td>
                            {% endfor %}
                        </tr>
                        {% for key, procedure in data %}
                            {% if key != 'observations' %}
                                <tr>
                                    <td class="border-end fw-bold">{{ procedure['name'] }}</td>
                                    {% for i in startDay..endDay %}
                                        {% if i in procedure['days'] %}
                                            <td class="text-dark border-end fw-bold">x</td>
                                        {% else %}
                                            <td class="text-dark border-end fs-6"></td>
                                        {% endif %}
                                    {% endfor %}
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </table>
                </div>
                <h3 class="card-title align-items-start flex-column">
                    <span class="card-label fw-bold fs-3 mb-1">Observații:</span>
                </h3>
                {% for key, procedure in data %}
                    {% if key == 'observations' %}
                        {% for item in procedure['observation'] %}
                            <p>{{ item['value'] }}; Data: {{ item['date'] }}</p>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}
