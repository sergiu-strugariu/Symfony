{{ form_widget(form._token) }}
<!--end::Input group-->
<div class="items" data-index="{{ form.cookMenuItems|length > 0 ? form.cookMenuItems|last.vars.name + 1 : 0 }}"  data-prototype="{{ form_widget(form.cookMenuItems.vars.prototype)|e('html_attr') }}">
    {% for item in form.cookMenuItems %}
        <div class="item">
            <div class="separator my-10"></div>
            <!--begin::Input group-->
            <div class="row mb-6">
                <!--begin::Label-->
                {{ form_label(item.day, 'Zi', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                <!--end::Label-->
                <!--begin::Col-->
                <div class="col-lg-9 fv-row">
                    {{ form_widget(item.day, {'attr': {'class': 'form-select form-select-lg form-select-solid'}}) }}
                    {{ form_errors(item.day) }}
                </div>
                <!--end::Col-->
            </div>
            <!--end::Input group-->
            <!--begin::Input group-->
            <div class="row mb-6">
                <!--begin::Label-->
                {{ form_label(item.breakfast, 'Mic dejun', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                <!--end::Label-->
                <!--begin::Col-->
                <div class="col-lg-9 fv-row">
