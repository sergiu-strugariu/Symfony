                    {{ form_widget(item.secondSnack, {'attr': {'class': 'form-control form-control-lg form-control-solid', 'placeholder': 'Gustare (17:00)'}}) }}
                    {{ form_errors(item.secondSnack) }}
                </div>
                <!--end::Col-->
            </div>
            <!--end::Input group-->
            <!--begin::Input group-->
            <div class="row mb-6">
                <!--begin::Label-->
                {{ form_label(item.dinner, 'Cina', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                <!--end::Label-->
                <!--begin::Col-->
                <div class="col-lg-9 fv-row">
                    {{ form_widget(item.dinner, {'attr': {'class': 'form-control form-control-lg form-control-solid', 'placeholder': 'Cina'}}) }}
                    {{ form_errors(item.dinner) }}
