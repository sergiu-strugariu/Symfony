<!--begin::Input group-->
<div class="row mb-6">
    <!--begin::Label-->
    {{ form_label(form.name, 'Nume', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
    <!--end::Label-->
    <!--begin::Col-->
    <div class="col-lg-9 fv-row">
        {{ form_widget(form.name, {'attr': {'class': 'form-control form-control-lg form-control-solid', 'placeholder': 'Nume'}}) }}
        {{ form_errors(form.name) }}
    </div>
    <!--end::Col-->
</div>
<!--end::Input group-->
