                <!--begin::Label-->
                {{ form_label(item.dz, 'DZ', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                <!--end::Label-->
                <!--begin::Col-->
                <div class="col-lg-9 fv-row">
                    {{ form_widget(item.dz, {'attr': {'class': 'form-control form-control-lg form-control-solid', 'placeholder': 'DZ'}}) }}
                    {{ form_errors(item.dz) }}
                </div>
                <!--end::Col-->
            </div>
            <!--end::Input group-->
        </div>
    {% endfor %}
</div>

<button type="button" class="btn btn-primary add_item_link my-3" data-collection-holder-class="items">Adaugă meniu per zi</button>
