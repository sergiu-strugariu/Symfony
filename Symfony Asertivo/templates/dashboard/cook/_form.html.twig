                    {{ form_errors(item.lunch) }}
                </div>
                <!--end::Col-->
            </div>
            <!--end::Input group-->
            <!--begin::Input group-->
            <div class="row mb-6">
                <!--begin::Label-->
                {{ form_label(item.secondSnack, 'Gustare (17:00)', {'label_attr': {'class': 'col-lg-3 col-form-label fw-semibold fs-6'}}) }}
                <!--end::Label-->
                <!--begin::Col-->
