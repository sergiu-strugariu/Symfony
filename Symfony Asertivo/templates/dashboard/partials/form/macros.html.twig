{% macro input(variable, id, entity) %}
    {% set inputName ="fields[" ~ entity ~ "][" ~ id ~ "][" ~ variable['field'] ~ "]" %}
    {% set file = constant('App\\Helper\\PageBuilderHelper::FILE_TYPE') %}
    <div class="row mb-6">
        <label class="col-lg-2 {{ variable['required'] ? 'required' : '' }} col-form-label fw-semibold fs-6">
            {{ variable['label'] }}
        </label>
        <div class="col-lg-10 fv-row">
            <input
                    type="{{ variable['type'] }}"
                    {{ variable['required'] and not variable['value'] ? 'required' : '' }}
                    value="{{ variable['type'] == file ? '' : variable['value'] }}"
                    name={{ inputName }}
                    placeholder="{{ variable['placeholder'] }}"
                    class="form-control form-control-solid form-control-lg rounded-0"
            />
            {% if variable['type'] == file %}
                {% if variable['value'] %}
                    <div class="form-text">
                        File uploaded:
                        <a href="{{ asset(app_default_page_path ~ entity|lower ~'/'~ variable['value'], 'cloudflare') }}"
                           target="_blank">
                            {{ variable['value'] }}
                        </a>
                    </div>
                {% endif %}
                <div class="form-text">(format acceptat: jpg, jpeg, png, .svg max. 3M)</div>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% macro checkbox(variable, id, entity) %}
    {% set inputName ="fields[" ~ entity ~ "][" ~ id ~ "][" ~ variable['field'] ~ "]" %}
    <div class="row mb-6">
        <label class="col-lg-2 col-form-label fw-semibold fs-6">
            {{ variable['label'] }}
        </label>
        <div class="col-lg-10 fv-row">
            <div class="form-check form-check-solid form-switch form-check-custom fv-row">
                <input type="hidden"
                       name="{{ inputName }}"
                       value="0"
                       class="hidden-checkbox-value"
                />
                <input
                        type="{{ variable['type'] }}"
                        value="{{ variable['value'] }}"
                        name="{{ inputName }}"
                        class="form-check-input w-45px h-30px"
                        {{ variable['value'] ? 'checked' : '' }}
                />
            </div>
        </div>
    </div>
{% endmacro %}

{% macro hidden(id, entity, field, value) %}
    {% set inputName ="fields[" ~ entity ~ "][" ~ id ~ "][" ~ field ~ "]" %}
    <input
            type="hidden"
            value="{{ value }}"
            name="{{ inputName }}"
            required="required"
    />
{% endmacro %}

{% macro textarea(variable, id, entity, rows = 5, cols = 40) %}
    {% set inputName ="fields[" ~ entity ~ "][" ~ id ~ "][" ~ variable['field'] ~ "]" %}

    <div class="row mb-6">
        <label class="col-lg-2 {{ variable['required'] ? 'required' : '' }} col-form-label fw-semibold fs-6">
            {{ variable['label'] }}
        </label>
        <div class="col-lg-10 fv-row">
        <textarea
                type="{{ variable['type'] }}"
                rows="{{ rows }}"
                cols="{{ cols }}"
                name="{{ inputName }}"
                placeholder="{{ variable['placeholder'] }}"
                class="form-control form-control-solid form-control-lg rounded-0 {{ variable['field'] != 'metaDescription' ? 'tinymce-editor' : '' }}">{{ variable['value'] }}</textarea>
        </div>
    </div>
{% endmacro %}

{% macro link(variable, id, entity) %}
    {% set inputName = "fields[" ~ entity ~ "][" ~ id ~ "]" %}
    <div class="row mb-6">
        <label class="col-lg-2 {{ variable['required'] ? 'required' : '' }} col-form-label fw-semibold fs-6">
            {{ variable['label'] }}:
        </label>
        <div class="col-lg-10 items">
            {% for value in variable['value'] %}
                {% set inputNameBase = "fields[" ~ entity ~ "][" ~ id ~ "][" ~ variable['field'] ~ "]" %}
                <div class="d-flex align-items-center repeater-item__{{ id }}" data-repeater-index="{{ loop.index0 }}">
                    <input
                            type="text"
                            name="{{ inputNameBase ~ '[' ~ loop.index0 ~ '][title]' }}"
                            value="{{ value['title'] }}"
                            placeholder="{{ variable['placeholderTitle'] }}"
                            class="form-control form-control-solid form-control-lg rounded-0 m-1"
                            {{ variable['required'] and not variable['value'] ? 'required' : '' }}
                    />
                    <input
                            type="url"
                            name="{{ inputNameBase ~ '[' ~ loop.index0 ~ '][url]' }}"
                            value="{{ value['url'] }}"
                            placeholder="{{ variable['placeholderLink'] }}"
                            class="form-control form-control-solid form-control-lg rounded-0 m-1"
                            {{ variable['required'] and variable['value'] is not empty ? 'required' : '' }}
                    />
                    <button  type="button" class="btn btn-light-danger btn-icon btn-sm remove-repeater-btn" {{ loop.first ? 'disabled="disabled"' : '' }}>
                        <i class="far fa-trash-alt px-3 remove-repeater-btn"></i>
                    </button>
                </div>
            {% endfor %}
            <button class="btn btn-primary w-100 my-5 btn-pill add-repeater-btn"
                    data-input-name="{{ inputName }}"
                    data-machine-name="{{ id }}"
                    data-repeater-items="{{ variable['value']|length }}"
                    data-template-name="{{ variable['field'] }}"
            >
                Adaugă link
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
{% endmacro %}

{% macro gallery(variable, id, entity, type) %}
    {% set inputName = "fields[" ~ entity ~ "][" ~ id ~ "]" %}
    <div class="row mb-6">
        <label class="col-lg-2 {{ variable['required'] ? 'required' : '' }} col-form-label fw-semibold fs-6">
            {{ variable['label'] }}:
        </label>
        <div class="col-lg-10">
            <div class="row items draggable-galleries__{{ id }}">
                {% for value in variable['value']|sort((a, b) => a['weight'] <=> b['weight']) %}
                    {% set inputNameBase = "fields[" ~ entity ~ "][" ~ id ~ "][" ~ variable['field'] ~ "]" %}
                    {% set imagePath = type == constant('App\\Helper\\PageBuilderHelper::SECTION') ? app_page_section_gallery_path : app_page_widget_gallery_path %}
                    <div class="col-md-6 mb-6 repeater-item__{{ id }}" data-repeater-index="{{ loop.index0 }}">
                        <div class="card card-bordered">
                            <div class="card-header my-3 justify-content-center">
                                <div class="image-input image-input-outline">
                                    <div class="image-input-wrapper" style="background-image: url({{ asset(imagePath ~ value['fileName'], 'cloudflare') }})"></div>
                                </div>
                                <div class="my-3">
                                    <input type="file"
                                           name="{{ inputNameBase ~ '[' ~ loop.index0 ~ '][fileName]' }}"
                                           value="{{ value['fileName'] }}"
                                           accept="image/jpeg, image/png, image/webp, image/svg+xml"
                                           class="form-control form-control-solid form-control-lg rounded-0 m-1"
                                    />
                                    <input type="hidden"
                                           name="{{ inputNameBase ~ '[' ~ loop.index0 ~ '][weight]' }}"
                                           value="{{ value['weight'] }}"
                                    />
                                </div>
                            </div>
                            <div class="card-body d-flex align-items-center">
                                <input
                                        type="text"
                                        name="{{ inputNameBase ~ '[' ~ loop.index0 ~ '][title]' }}"
                                        value="{{ value['title'] }}"
                                        placeholder="{{ variable['placeholderTitle'] }}"
                                        class="form-control form-control-solid form-control-lg rounded-0 m-1"
                                        {{ variable['required'] and not variable['value'] ? 'required' : '' }}
                                />
                                <button type="button" class="btn btn-light-danger btn-icon btn-sm px-3 remove-repeater-btn" {{ loop.first ? 'disabled="disabled"' : '' }}>
                                    <i class="far fa-trash-alt remove-repeater-btn"></i>
                                </button>
                                <button type="button" class="btn btn-icon btn-light-dark btn-sm mx-2 px-3 draggable-handle__gallery__{{ id }}">
                                    <i class="fas fa-grip-horizontal"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                <button class="btn btn-primary my-5 add-repeater-btn"
                        data-input-name="{{ inputName }}"
                        data-machine-name="{{ id }}"
                        data-repeater-items="{{ variable['value']|length }}"
                        data-template-name="{{ variable['field'] }}">
                    Adaugă imagine
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
    </div>
{% endmacro %}