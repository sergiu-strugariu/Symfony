<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
    <head>
        <title>NursingOS</title>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <style type="text/css">
            #outlook a {
                padding: 0;
            }
            a, a:link, a:visited {
                text-decoration: none;
                outline: none;
            }
            a:hover {
                text-decoration: underline;
            }
            p {
                margin: 1.25em 0;
                line-height: 1.125em;
            }
            body {
                width: 100% !important;
                -webkit-text-size-adjust: 100%;
                -ms-text-size-adjust: 100%;
                margin: 0;
                padding: 0;
            }
            .ExternalClass {
                width: 100%;
            }
            .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div {
                line-height: 100%;
            }
            #backgroundTable {
                margin: 0;
                padding: 0;
                width: 100% !important;
                line-height: 100% !important;
            }
            img {
                outline: none;
                text-decoration: none;
                -ms-interpolation-mode: bicubic;
                display: block;
            }
            a img {
                border: none;
                outline: none;
            }
            table td {
                border-collapse: collapse;
            }
            table {
                border-collapse: collapse;
                mso-table-lspace: 0pt;
                mso-table-rspace: 0pt;
            }
        </style>
    </head>
    <body yahoo="fix" marginwidth="0" marginheight="0" style="margin-top: 0px; margin-bottom: 0px; padding: 0px; width: 100% !important; background-color: #FFF;" topmargin="0" leftmargin="0" bgcolor="#FFF">
        <div align="center">
            <table cellpadding="0" cellspacing="0" border="0" bgcolor="#FFF" id="backgroundTable" align="center" style="background-color: #FFF;">
                <tr>
                    <td align="left">
                        <table cellpadding="0" cellspacing="0" border="0" bgcolor="#FFF">
                            <tr>
                                <td valign="top">
                                    {{ message|raw }}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </body>
</html>