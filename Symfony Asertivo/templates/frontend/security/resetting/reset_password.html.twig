{% extends 'layout_auth.html.twig' %}

{% block title %}Reset password {{ parent() }} {% endblock %}

{% form_theme form 'dashboard/shared/form/form_errors.html.twig' %}

{% block content %}
    <div class="content section">
        <div class="inner">
            <h2>Tastează parola ta nouă</h2>
            <p><small>Parola ta nouă trebuie să fie diferită față de versiunile anterioare </small></p>
            <div class="form-section form-wrapper has-loader">

                {{ form_start(form, {'attr': {'id': ''}}) }}
                <div class="form-group">
                    {{ form_widget(form.password.first, {'attr': {'id': 'password','class': '', 'placeholder': 'Tastează noua parolă', 'autocomplete': 'off'}}) }}
                    {{ form_errors(form.password.first) }}
                </div>
                <div class="form-group">
                    {{ form_widget(form.password.second, {'attr': {'id': 'confirmPassword','class': '', 'placeholder': 'Confirmă noua parolă', 'autocomplete': 'off'}}) }}
                    {{ form_errors(form.password.second) }}
                </div>

                <div class="form-action">
                    <input type="submit" class="submit-btn" value="Schimbă parola"/>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
