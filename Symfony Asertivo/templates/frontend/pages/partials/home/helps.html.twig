<div class="how-do-we-help ">
    <div class="inner section">
        <h2>{{ section.name }}</h2>
        <div class="content">
            <div class="accordion-section">
                {% for widget in section.pageWidgets %}
                    {% include 'frontend/pages/partials/home/widgets/' ~ widget.template ignore missing %}
                {% endfor %}
            </div>
            <div class="accordion-image d-none d-lg-block">
                <!--data-image is updated from js-->
                <div class="image" data-image=""></div>
            </div>
        </div>
    </div>
</div>
