<div class="see-how section">
    <div class="inner">
        {{ section.description|raw }}
        {% for link in section.links %}
            <a href="{{ link.url }}" class="{{ loop.index0 == 0 ? 'blue-btn' : 'border-btn' }}">
                {{ link.title }}
            </a>
        {% endfor %}
    </div>
</div>
<div class="see-how-swiper section">
    <div class="inner">
        <div class="swiper-container">
            <div class="swiper-wrapper">
                {% for widget in section.pageWidgets %}
                    {% include 'frontend/pages/partials/home/widgets/' ~ widget.template ignore missing %}
                {% endfor %}
            </div>
            <div class="controls">
                <div class="swiper-pagination-seeHowCarousel bullets-wrapper"></div>
            </div>
        </div>
    </div>
</div>