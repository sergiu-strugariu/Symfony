{% extends 'layout_email.html.twig' %}
{% block title %}{{ parent() }} {{ pageTitle }}{% endblock %}

{% block content %}
    <tr>
        <td style="padding: 0">
            <img src="{{ absolute_url(asset('assets/frontend/images/email-templates/intro-reset-password.png')) }}" alt="intro-img" style="width: 100%; max-width: 650px; height: auto; display: block;">
        </td>
    </tr>

    <tr style="background-color: #FFFFFF;">
        <td style="padding: 35px 20px 35px 20px; text-align: center; max-width: 480px; margin: 0 auto;">
            <p style="font-family: Arial, sans-serif; font-weight: 400; font-size: 16px; line-height: 24px; color: #1D2130; max-width: 485px;">
                Buna, {{ user.fullName }},
            </p>
            <p style="padding-bottom: 20px; font-family: Arial, sans-serif; font-weight: 400; font-size: 16px; line-height: 24px; color: #1D2130; max-width: 485px;">
                Am primit o solicitare pentru resetarea parolei contului tău NursingHelp. Dacă tu ai inițiat această cerere, apasă pe butonul de mai jos pentru a seta o nouă parolă:
            </p>
            <a href="{{ resettingUrl }}" style="display: block; max-width: 230px; line-height: 66px; margin: 0 auto; font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 700; color: #ffffff; background-color: #3366CC; border-radius: 10px; text-decoration: none;">
                Resetează parola
            </a>
            <p style="padding-top: 22px; font-family: Arial, sans-serif; font-weight: 400; font-size: 16px; line-height: 24px; color: #1D2130; max-width: 485px;">
                Acest link va fi activ timp de 24 de ore. Dacă nu ai cerut resetarea parolei, te rugăm să ignori acest email, contul tău este în siguranță.
            </p>
            <p style="font-family: Arial, sans-serif; font-weight: 400; font-size: 16px; line-height: 24px; color: #1D2130; max-width: 485px;">
                Dacă întâmpini probleme sau ai nevoie de ajutor, nu ezita să ne contactezi.
            </p>

        </td>
    </tr>
{% endblock %}