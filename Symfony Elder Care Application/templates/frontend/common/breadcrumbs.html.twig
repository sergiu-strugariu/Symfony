<div class="breadcrumb">
    <ul>
        {% for item in breadcrumbs %}
            <li>
                {% if item.route is not empty %}
                    <a href="{{ path(item.route, item.params) }}">
                        {{ item.name }}
                    </a>
                {% else %}
                    {{ item.name }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</div>
