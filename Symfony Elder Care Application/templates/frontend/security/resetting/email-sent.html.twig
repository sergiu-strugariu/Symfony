{% extends 'layout_auth.html.twig' %}

{% block title %}Email Trimis {{ parent() }} {% endblock %}

{% block content %}
    <div class="content section">
        <div class="inner">
            <div class="error-image">
                <img src="{{ asset('assets/frontend/images/icons/email-succes-icon.svg') }}" alt="email-success-icon">
            </div>
            <h2>Emailul a fost trimis.</h2>
            <p><small>Dacă e-mailul există în sistemul nostru, vom trimite în cateva minute un e-mail cu
                    instrucțiuni pentru
                    a reseta parola. Dacă nu apare, te rugăm să verifici și în Spam.</small></p>
            <a href="{{ path('dashboard_login') }}" class="forgotPass">Înapoi la Login</a>
        </div>
    </div>
{% endblock %}