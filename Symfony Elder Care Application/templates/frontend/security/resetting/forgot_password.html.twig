{% extends 'layout_auth.html.twig' %}

{% block title %}Forgot password {{ parent() }} {% endblock %}

{% form_theme form 'dashboard/shared/form/form_errors.html.twig' %}

{% block content %}
    <div class="content section">
        <div class="inner">
            <h2>Ai uitat parola?</h2>
            <p>
                <small>Introdu adresa de e-mail și îți vom trimite un email pentru a reseta parola. Poate fi
                    necesar
                    să
                    verifici folderul Spam.
                </small>
            </p>
            <div class="form-section form-wrapper has-loader">
                {{ form_start(form, {'attr': {'id': '','class': ''}}) }}

                <div class="form-group">
                    {{ form_label(form.email, 'Email*') }}
                    {{ form_widget(form.email, {'attr': {'id': '', 'placeholder': 'Email', 'class': 'form-control bg-transparent', 'autocomplete': 'off'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="form-action">
                    <input type="submit" class="submit-btn" value="Trimite"/>
                </div>

                <a href="{{ path('app_login') }}" class="forgotPass">Înapoi la Login</a>
                {{ form_end(form) }}

            </div>
        </div>
    </div>
{% endblock %}