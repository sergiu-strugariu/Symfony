{% extends 'layout_auth.html.twig' %}

{% block title %}Login {{ parent() }}{% endblock %}

{% block content %}
    <div class="content section">
        <div class="inner">
            <h2>Loghează-te</h2>
            <p><small>Nu ai cont pe {{ app_name }}? <a href="{{ path('dashboard_register') }}">Creează cont în 2 minute</a></small></p>
            <div class="form-section form-wrapper has-loader">
                <form class="form w-100" method="POST" action="{{ path('dashboard_login') }}">

                    {% include 'frontend/common/alerts.html.twig' %}

                    {% if error %}
                        <p class="text-center text-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                    {% endif %}

                    <div class="form-group">
                        <label for="emailAddress">Email*</label>
                        <input type="text" placeholder="Email" name="_username" value="{{ last_username }}"
                               autocomplete="off" class="emailAddress"/>
                    </div>
                    <div class="form-group">
                        <label for="password">Parola*</label>
                        <input type="password" placeholder="Parola" name="_password" autocomplete="off"
                               class="password"/>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <input type="hidden" name="_target_path" value="{{ path('dashboard_user_profile') }}"/>

                    <a href="{{ path('dashboard_resetting_forgot_password') }}" class="forgotPass">Am uitat parola</a>

                    <div class="form-action">
                        <input type="submit" class="submit-btn" value="Intra in cont"/>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}