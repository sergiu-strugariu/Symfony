{% extends 'layout_frontend.html.twig' %}

{% block title %}{{ page.name }} {{ parent() }}{% endblock %}
{% block content %}
    {% if page %}
        <main class="{{ page.classes }}">
            {% include "frontend/common/breadcrumbs.html.twig" %}

            {% for section in page.pageSections %}
                {% include 'frontend/pages/partials/legal/' ~ section.template ignore missing %}
            {% endfor %}
        </main>
    {% endif %}
{% endblock %}