<div class="cta-short section">
    <div class="inner">
        <div>
            <div>
                <h3>{{ section.name }}</h3>
                {{ section.description|raw }}
            </div>
            <div>
                {% set packagePath = is_granted('IS_AUTHENTICATED_FULLY') ? path('app_comand_detail', {'slug': 'gratuit-30-zile'}) : url('app_login', {'returnUrl': path('app_packages')}) %}
                <a href="{{ packagePath }}" class="packageButton" data-href="{{ packagePath }}">
                    Comandă acum
                </a>
            </div>
        </div>
    </div>
</div>