<div role="region" aria-labelledby="caption" tabindex="0">
    <table>
        <caption id="caption"></caption>
        <thead>
        <tr>
            <th></th>
            {% for package in packages %}
                {% set packagePath = is_granted('IS_AUTHENTICATED_FULLY') ? path('app_order_details', {'slug': package.slug}) : url('app_login', {'returnUrl': path('app_packages')}) %}
                <th>
                    <div>
                        <img src="{{ asset(app_membership_package_path ~ package.fileName, 'cloudflare') }}"
                             alt="{{ package.name }}"
                        />
                        <p>{{ package.name }}</p>
                    </div>
                    <p class="packagePrice"
                       data-price="{{ package.price > 0 ? package.price : '0' }}"
                       data-discount="{{ package.yearlyPricePerMonth }}">0 RON / an
                    </p>
                    {% if loop.index != 1 %}
                        <a class="packageButton" href="{{ packagePath }}" data-href="{{ packagePath }}">
                            Comandă acum
                        </a>
                    {% else %}
                        <a  href="{{ url('app_register', {'returnUrl': path('app_packages')}) }}">
                            Creează cont
                        </a>
                    {% endif %}
                </th>
            {% endfor %}
        </tr>
        </thead>

        <tbody>
        {% for moduleData in modules %}
            {% for key, featureData in moduleData %}
                {% if key == 'title' %}
                    <tr>
                        <th>{{ moduleData.title }}</th>
                    </tr>
                {% else %}
                    <tr>
                        {% if key != 'packages' and featureData is iterable %}
                            <th>
                                <div>
                                    <img src="{{ asset('assets/frontend/images/packages/icons/' ~ featureData.icon) }}"
                                         alt="icon"/>
                                    <p>{{ featureData.title }}</p>
                                </div>
                            </th>
                            {% for package in moduleData.packages %}
                                <td class="{{ package ? 'active' : '' }}"></td>
                            {% endfor %}
                        {% endif %}
                    </tr>
                {% endif %}
            {% endfor %}
        {% endfor %}
        </tbody>
    </table>
</div>