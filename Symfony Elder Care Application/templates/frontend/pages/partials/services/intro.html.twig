<div class="video-intro">
    <div class="inner">
        <div class="image" style="background-image: url({{ asset(app_page_section_path ~ section.fileName, 'cloudflare') }})"></div>
        <div class="video-wrapper" style="background-image: url({{ asset(app_page_section_path ~ section.fileNameMob, 'cloudflare') }})"></div>
        <div class="content">
            <h1>{{ section.name }}</h1>
            {{ section.description|raw }}
            <a href="{{ section.link }}" class="blue-btn">
                {{ section.linkText }}
            </a>
        </div>
    </div>
</div>