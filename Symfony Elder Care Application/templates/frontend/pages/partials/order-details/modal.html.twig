                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="label" for="companyRegisterNumber">Nr registrul comertului*</label>
                            <input type="text" name="companyRegisterNumber" id="nrRegCom">

                        </div>
                        <div class="form-group">
