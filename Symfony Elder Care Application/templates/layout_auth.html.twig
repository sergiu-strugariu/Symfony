{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('assets/frontend/styles/style.min.css') }}"/>
{% endblock %}

{% block body %}
    <main class="{{ class }}">
        <div class="left-content">
            <!-- Start: Header-->
            {% include "frontend/common/auth/header.html.twig" %}
            <!-- End: Header -->

            <!-- Start: Content-->
            {% block content %}{% endblock %}
            <!-- End: Content -->

            <!-- Start: Footer -->
            {% include "frontend/common/auth/footer.html.twig" %}
            <!-- End: Footer -->
        </div>
        <div class="right-content">
            <div class="image" data-image="{{ asset(app_setting_path ~ settingService.service('authImage'), 'cloudflare') }}"></div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script>
        window.formMessages = {
            'name': {
                'minlength': 'Numele trebuie să aibă cel puțin 2 caractere',
                'valid_name': 'Numele poate conține doar litere, spații și cratime',
