                'email': 'Formatul adresei de email este invalid'
            },
            'phone': {
                'required': 'Introdu numărul de telefon',
                'minlength': 'Numarul minim este de 10 caractere',
                'maxlength': 'Numarul maxim este de 10 caractere',
                'phone_ro': 'Numărul de telefon nu este valid',
                'phone_match': 'Numărul de telefon nu trebuie să coincidă'
