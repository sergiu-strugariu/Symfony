            'form_messages': {
                'form_details_success': 'Felicitări! Cererea ta a fost trimisă cu success. Vom reveni în cel mai scurt timp posibil',
                'form_details_error': 'A intervenit o eroare neprevăzută. Te rugăm să încerci din nou sau mai târziu',
                'form_recaptcha': 'Nu uita să bifezi recaptcha'
            },
            'cui': {
                'validCIF': 'CUI nu este valid',
                'required': 'Câmp este obligatoriu.'
            },
            'companyRegisterNumber': {
