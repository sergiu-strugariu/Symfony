{% extends 'layout.html.twig' %}

{% block title %}Camere {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-4">
            {% include 'dashboard/nursing_home/_nursing_home_tabs.html.twig' %}
            <!--begin::Header-->
            <div class="card-header border-0 pt-5">
                <div class="card-title align-items-start flex-column"></div>
                <div class="card-toolbar">
                    <a href="#" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                       data-bs-target="#kt_modal_add_nursing_home_room" data-nursing-home-location-room-uuid="0"
                       data-nursing-room-uuid="{{ nursingHome.uid }}">
                        <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                        <span class="svg-icon svg-icon-3">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1"
                                      transform="rotate(-90 11.364 20.364)" fill="currentColor"/>
                                <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="currentColor"/>
                            </svg>
                        </span>
                        <!--end::Svg Icon-->
                        Adauga camera
                    </a>
                </div>
            </div>
            <!--end::Header-->
            <!--begin::Body-->
            <div class="card-body">
                <!--begin::Table container-->
                <div class="table-responsive">
                    <!--begin::Table-->
                    <table class="table table-row-dashed table-row-gray-300 align-middle gs-0 gy-4">
                        <!--begin::Table head-->
                        <thead>
                        <tr class="fw-bold text-muted">
                            <th>Camin</th>
                            <th>Nr camera</th>
                            <th>Etaj</th>
                            <th>Nr locuri</th>
                            <th>Detalii</th>
                            <th>Tip camera</th>
                            <th>Pacienți</th>
                            <th>Locuri libere</th>
                            <th class="min-w-50px text-end">Acțiuni</th>
                        </tr>
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody>
                        {% for room in rooms %}
                            <tr>
                                <td>
                                    <span class="text-dark fw-bold fs-6">{{ room['nursingHome'] }}</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold fs-6">{{ room['number'] }}</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold fs-6">{{ room['floor'] }}</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold fs-6">{{ room['totalBeds'] }}</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold fs-6">{{ room['details'] }}</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold fs-6">{{ room['type'] }}</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold fs-6">{{ room['pacients'] }}</span>
                                </td>
                                <td>
                                    <span class="text-dark fw-bold fs-6">{{ room['availableBeds'] }}</span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end flex-shrink-0">
                                        <a href="#" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm"
                                           data-bs-toggle="modal" data-bs-target="#kt_modal_add_nursing_home_room"
                                           data-nursing-home-location-room-uuid="{{ room['uuid'] }}"
                                           data-nursing-room-uuid="{{ nursingHome.uid }}">
                                            <span class="svg-icon svg-icon-3 mx-2">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         xmlns:xlink="http://www.w3.org/1999/xlink" width="24px"
                                                         height="24px" viewBox="0 0 24 24" version="1.1">
                                                        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                            <rect x="0" y="0" width="24" height="24"/>
                                                            <path d="M8,17.9148182 L8,5.96685884 C8,5.56391781 8.16211443,5.17792052 8.44982609,4.89581508 L10.965708,2.42895648 C11.5426798,1.86322723 12.4640974,1.85620921 13.0496196,2.41308426 L15.5337377,4.77566479 C15.8314604,5.0588212 16,5.45170806 16,5.86258077 L16,17.9148182 C16,18.7432453 15.3284271,19.4148182 14.5,19.4148182 L9.5,19.4148182 C8.67157288,19.4148182 8,18.7432453 8,17.9148182 Z" fill="currentColor" fill-rule="nonzero" transform="translate(12.000000, 10.707409) rotate(-135.000000) translate(-12.000000, -10.707409) "/>
                                                            <rect fill="currentColor" opacity="0.3" x="5" y="20" width="15" height="2" rx="1"/>
                                                        </g>
                                                    </svg>
                                                </span>
                                            <!--end::Svg Icon-->
                                        </a>
                                        <a href="#" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm mx-2 add_pacients"
                                           data-nursing-home-location-room-uuid="{{ room['uuid'] }}"
                                           data-nursing-room-uuid="{{ nursingHome.uid }}">
                                            <span class="svg-icon svg-icon-3">
                                                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                        <polygon points="0 0 24 0 24 24 0 24"/>
                                                        <path d="M18,8 L16,8 C15.4477153,8 15,7.55228475 15,7 C15,6.44771525 15.4477153,6 16,6 L18,6 L18,4 C18,3.44771525 18.4477153,3 19,3 C19.5522847,3 20,3.44771525 20,4 L20,6 L22,6 C22.5522847,6 23,6.44771525 23,7 C23,7.55228475 22.5522847,8 22,8 L20,8 L20,10 C20,10.5522847 19.5522847,11 19,11 C18.4477153,11 18,10.5522847 18,10 L18,8 Z M9,11 C6.790861,11 5,9.209139 5,7 C5,4.790861 6.790861,3 9,3 C11.209139,3 13,4.790861 13,7 C13,9.209139 11.209139,11 9,11 Z" fill="currentColor" fill-rule="nonzero" opacity="0.3"/>
                                                        <path d="M0.00065168429,20.1992055 C0.388258525,15.4265159 4.26191235,13 8.98334134,13 C13.7712164,13 17.7048837,15.2931929 17.9979143,20.2 C18.0095879,20.3954741 17.9979143,21 17.2466999,21 C13.541124,21 8.03472472,21 0.727502227,21 C0.476712155,21 -0.0204617505,20.45918 0.00065168429,20.1992055 Z" fill="currentColor" fill-rule="nonzero"/>
                                                    </g>
                                                </svg>
                                            </span>
                                            <!--end::Svg Icon-->
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Table container-->
            </div>
            <!--begin::Body-->

        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block modals %}
    {% include 'dashboard/nursing_home/modal/__add_pacient.html.twig' %}
    {% include 'dashboard/shared/modal/add_nursing_home_room.html.twig' %}
    {% include 'dashboard/shared/toast/default.html.twig' %}
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTNursingHomeRoom.init('{{ nursingHome.uid }}');
        });
    </script>
{% endblock %}
