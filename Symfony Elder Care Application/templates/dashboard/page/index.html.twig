{% extends 'layout.html.twig' %}

{% block title %} Pages {{ parent() }} {% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body py-4">
            {% include 'dashboard/shared/alerts.html.twig' %}
            <div class="d-flex flex-stack mb-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <input type="text" data-kt-pages-table-filter="search" class="form-control form-control-solid w-250px ps-15" placeholder="Cauta..."/>
                </div>
                <!--end::Search-->
                <!--begin::Toolbar-->
                <div class="d-flex justify-content-end" data-kt-user-table-toolbar="base">
                    <!--begin::Add user -->
                    <a href="{{ path('dashboard_page_create') }}" type="button" class="btn btn-primary">
                        <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                        <span class="svg-icon svg-icon-2"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="currentColor"></rect>
                                <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="currentColor"></rect>
                            </svg></span>
                        <!--end::Svg Icon-->
                        Adauga pagina
                    </a>
                    <!--end::Add customer-->
                </div>
                <!--end::Toolbar-->
            </div>

            <table id="kt_datatable_pages" class="table align-middle table-row-dashed fs-6 gy-5">
                <thead>
                <tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                    <th>#ID</th>
                    <th>Nume</th>
                    <th>URL</th>
                    <th>Data creării</th>
                    <th>Acțiuni</th>
                </tr>
                </thead>
                <tbody class="text-gray-600 fw-semibold">
                </tbody>
            </table>

        </div>
    </div>
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTDatatablePages.init();
        });
    </script>
{% endblock %}