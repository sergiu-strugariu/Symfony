{% extends 'layout.html.twig' %}

{% block title %}Internari {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-4">
            {% include 'dashboard/shared/tabs.html.twig' %}
            <!--begin::Wrapper-->
            <div class="d-flex flex-stack my-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <input type="text" data-kt-admissions-table-filter="search" class="form-control form-control-solid w-250px ps-15" placeholder="Cauta..."/>
                </div>
                <!--end::Search-->
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OWNER') or is_granted('ROLE_MANAGEMENT') or is_granted('ROLE_MEDIC') %}
                    <!--begin::Toolbar-->
                    <div class="d-flex justify-content-end" data-kt-admissions-table-toolbar="base">
                        <!--begin::Add admission -->
                        <a href="{{ path('dashboard_pacients_admission_wizard', {'step': 1}) }}" class="btn btn-primary">
                            <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                            <span class="svg-icon svg-icon-2"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="currentColor"></rect>
                                    <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="currentColor"></rect>
                                </svg></span>
                            <!--end::Svg Icon-->       
                            Adaugare internare
                        </a>
                        <!--end::Add admission-->
                    </div>
                    <!--end::Toolbar-->
                {% endif %}
            </div>
            <!--end::Wrapper-->

            <!--begin::Datatable-->
            <table id="kt_datatable_admissions" class="table align-middle table-row-dashed fs-6 gy-5">
                <thead>
                    <tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                        <th>Data</th>
                        <th>Nume si prenume</th>
                        <th>Tip pacient</th>
                        <th>Mobilitate</th>
                        <th>Pampers</th>
                        <th>Regim alimentar</th>
                        <th>Pat medical</th>
                        <th>Internat de</th>
                    </tr>
                </thead>
                <tbody class="text-gray-600 fw-semibold">
                </tbody>
            </table>
            <!--end::Datatable-->
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTDatatablesAdmissions.init();
        });
    </script>
{% endblock %}