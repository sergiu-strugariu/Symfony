{% extends 'layout.html.twig' %}

{% block title %}Detalii {{ pacient.name }} {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-4">
            {% include 'dashboard/shared/breadcrumbs.html.twig' %}
            {% include 'dashboard/pacient/_pacient_tabs.html.twig' %}
            <div class="p-5">
                <h3>Evolutie tensiune</h3>
                <canvas id="kt_chartjs_blood_pressure" class="mh-400px"></canvas>
            </div>
            <div class="p-5">
                <h3>Evolutie saturatie</h3>
                <canvas id="kt_chartjs_saturation" class="mh-400px"></canvas>
            </div>
            <div class="p-5">
                <h3>Evolutie puls</h3>
                <canvas id="kt_chartjs_heart_rate" class="mh-400px"></canvas>
            </div>
            <div class="p-5">
                <h3>Evolutie glicemie</h3>
                <canvas id="kt_chartjs_glucose" class="mh-400px"></canvas>
            </div>
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTPacientOverviewCharts.init('{{ pacient.uid }}');
        });
    </script>
{% endblock %}
