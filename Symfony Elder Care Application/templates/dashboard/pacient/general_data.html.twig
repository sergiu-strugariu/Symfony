{% extends 'layout.html.twig' %}

{% block title %}Date generale {{ pacient.name }} {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-4">
            {% include 'dashboard/shared/breadcrumbs.html.twig' %}
            {% include 'dashboard/pacient/_pacient_tabs.html.twig' %}
            <!--begin::Wrapper-->
            <div class="d-flex flex-stack my-5">
                <!--begin::Search-->
                <div class="d-flex align-items-center position-relative my-1">
                    <input type="text" data-kt-pacient-general-data-table-filter="search" class="form-control form-control-solid w-250px ps-15" placeholder="Cauta..."/>
                </div>
                <!--end::Search-->
                <!--begin::Toolbar-->
                <div class="d-flex justify-content-end" data-kt-pacient-general-data-table-toolbar="base">
                    <!--begin::Add user -->
                    <button type="button" class="btn btn-primary" id="kt_add_pacient_general_data">
                        <!--begin::Svg Icon | path: icons/duotune/arrows/arr075.svg-->
                        <span class="svg-icon svg-icon-2"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="11.364" y="20.364" width="16" height="2" rx="1" transform="rotate(-90 11.364 20.364)" fill="currentColor"></rect>
                                <rect x="4.36396" y="11.364" width="16" height="2" rx="1" fill="currentColor"></rect>
                            </svg></span>
                        <!--end::Svg Icon-->       
                        Adauga data generale
                    </button>
                    <!--end::Add customer-->
                </div>
                <!--end::Toolbar-->
            </div>
            <!--end::Wrapper-->
            <!--begin::Datatable-->
            <table id="kt_datatable_pacient_general_data" class="table align-middle table-row-dashed fs-6 gy-5">
                <thead>
                    <tr class="text-start text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                        <th>Data internarii</th>
                        <th>Adaugat de</th>
                        <th>Tip pacient</th>
                        <th>Mobilitate</th>
                        <th>Pampers?</th>
                        <th>Pat medical?</th>
                        <th>Regim alimentar</th>
                        <th>Infectie nosocomiala</th>
                        <th>Actiuni</th>
                    </tr>
                </thead>
                <tbody class="text-gray-600 fw-semibold"></tbody>
            </table>
            <!--end::Datatable-->
            <div class="py-10 px-9">
                <form id="kt_pacient_general_data_form"></form>
            </div>
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block modals %}
    {% include 'dashboard/shared/toast/default.html.twig' %}
{% endblock %}

{% block page_javascripts %}
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTDatatablesPacientGeneralData.init('{{ pacient.uid }}');
        });
    </script>
{% endblock %}
