{% extends 'layout.html.twig' %}

{% block title %}Propunere financiara {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-4">
            <!--begin::Tabs-->
            {% include 'dashboard/pacient/_pacient_tabs.html.twig' %}
            {% include 'dashboard/shared/alerts.html.twig' %}
            <table class="table gs-0 gy-4">
                <tr>
                    <td class="text-dark fw-bold fs-6">Destinatar</td>
                    <td class="text-dark fw-bold fs-6">Expeditor</td>
                    <td class="text-dark fw-bold fs-6">Subiect</td>
                    <td class="text-dark fw-bold fs-6">Data</td>
                    <td class="text-dark fw-bold fs-6">Open</td>
                </tr>
                {% for email in emails %}
                    <tr>
                        <td class="text-dark fs-6">{{ email.recipientEmail }}</td>
                        <td class="text-dark fs-6">{{ email.senderEmail }}</td>
                        <td class="text-dark fs-6">{{ email.subject }}</td>
                        <td class="text-dark fs-6">{{ email.createdAt|date('d-m-Y H:i') }}</td>
                        <td class="text-dark fs-6">{{ email.opened }}</td>
                    </tr>
                {% endfor %}
            </table>
            <!--end::Tabs-->
            <form class="my-6" action="" method="POST">
                <!--begin::Input group-->
                <div class="row mb-6">
                    <div class="col-lg-12">
                        <!--begin::Label-->
                        <label class="col-form-label required fw-semibold fs-6">To</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <div class="fv-row">
                            <input type="text" name="to" id="to" class="form-control form-control-lg form-control-solid" value="{{ pacient.email }}" required>
                        </div>
                        <!--end::Input-->
                    </div>
                </div>
                <!--end::Input group-->
                <!--begin::Input group-->
                <div class="row mb-6">
                    <div class="col-lg-12">
                        <!--begin::Label-->
                        <label class="col-form-label fw-semibold fs-6">CC</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <div class="fv-row">
                            <input type="text" name="cc" id="cc" class="form-control form-control-lg form-control-solid">
                        </div>
                        <!--end::Input-->
                    </div>
                </div>
                <!--end::Input group-->
                <!--begin::Input group-->
                <div class="row mb-6">
                    <div class="col-lg-12">
                        <!--begin::Label-->
                        <label class="col-form-label fw-semibold fs-6">BCC</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <div class="fv-row">
                            <input type="text" name="bcc" id="bcc" class="form-control form-control-lg form-control-solid">
                        </div>
                        <!--end::Input-->
                    </div>
                </div>
                <!--end::Input group-->
                <!--begin::Input group-->
                <div class="row mb-6">
                    <div class="col-lg-12">
                        <!--begin::Label-->
                        <label class="col-form-label required fw-semibold fs-6">Subiect</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <div class="fv-row">
                            <input type="text" name="subject" class="form-control form-control-lg form-control-solid" placeholder="Introdu subiectul email-ului" value="Propunere financiara pentru institutionalizarea in centrul Asertivo - {{ pacient.beneficiaryName|default('Nume beneficiar') }}" required>
                        </div>
                        <!--end::Input-->
                    </div>
                </div>
                <!--end::Input group-->
                <!--begin::Input group-->
                <div class="row mb-6">
                    <div class="col-lg-12">
                        <!--begin::Label-->
                        <label class="col-form-label required fw-semibold fs-6">Pret</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <div class="fv-row">
                            <input type="text" name="price" class="form-control form-control-lg form-control-solid" placeholder="Introdu pretul total" required>
                        </div>
                        <!--end::Input-->
                    </div>
                </div>
                <!--end::Input group-->
                <!--begin::Input group-->
                <div class="row mb-6">
                    <div class="col-lg-12">
                        <!--begin::Label-->
                        <label class="col-form-label required fw-semibold fs-6">Propunere</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <div class="fv-row">
                            <textarea name="message" id="message" class="form-control form-control-lg form-control-solid" rows="8" placeholder="Introdu corpul email-ului"></textarea>
                        </div>
                        <!--end::Input-->
                    </div>
                </div>
                <!--end::Input group-->
                <!--begin::Col-->
                <div class="row mb-6">
                    <div class="col-lg-12">
                        <button type="submit" class="btn btn-lg btn-primary">Trimite</button>
                    </div>
                </div>
                <!--end::Col-->
            </form>
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block page_javascripts %}
    <script src="{{ asset('assets/dashboard/plugins/custom/tinymce/tinymce.bundle.js') }}"></script>
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTPacientProspectOffer.init('{{ pacient.uid }}');
        });
    </script>
{% endblock %}