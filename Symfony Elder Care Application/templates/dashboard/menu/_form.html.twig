<div class="card mb-5 mb-lg-3 card-flush">
    <!--begin::Form content-->
    {{ form_start(form, {'attr': {'class': 'form'}}) }}
    <div class="card-body py-4">
        <!--begin::Separator-->
        <div class="separator separator-content my-15">
            <span class="w-250px h2">Adaugă meniu</span>
        </div>
        <!--end::Separator-->
        <!--begin::Input group-->
        <div class="row mb-6">
            <!--begin::Label-->
            {{ form_label(form.title, 'Titlu', {'label_attr': {'class': 'col-lg-2 col-form-label fw-semibold fs-6'}}) }}
            <!--end::Label-->
            <!--begin::Col-->
            <div class="col-lg-10 fv-row">
                {{ form_widget(form.title, {'attr': {'class': 'form-control form-control-lg form-control-solid'}}) }}
                {{ form_errors(form.title) }}
            </div>
            <!--end::Col-->
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end py-6 px-9">
        <a href="{{ path('dashboard_menu_index') }}" class="btn btn-danger me-2">
            Renunță
        </a>
        <button type="submit" class="btn btn-success me-2">
            Salvează
        </button>
    </div>
    {{ form_end(form) }}
    <!--end::Form content-->
</div>
