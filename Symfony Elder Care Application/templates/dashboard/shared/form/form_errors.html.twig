{% block form_errors %}
    {% if errors|length > 0 %}
        {% for error in errors %}
            <div class="form-message error">
                <div aria-atomic="true" role="alert" class="error-message">
                    <div class="error message">
                        <p>{{ error.message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock form_errors %}