<!--begin::Modal - Summary settings-->
<div class="modal fade" id="kt_modal_summary_settings" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-800px">
        <!--begin::Modal content-->
        <div class="modal-content">
            <!--begin::Modal header-->
            <div class="modal-header" id="kt_modal_summary_settings_header">
                <!--begin::Modal title-->
                <h2 class="fw-bold">Setari</h2>
                <!--end::Modal title-->
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-kt-summary-settings-modal-action="close">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor" />
                        </svg>
                    </span>
                    <!--end::Svg Icon-->
                </div>
                <!--end::Close-->
            </div>
            <!--end::Modal header-->
            <!--begin::Modal body-->
            <div class="modal-body mx-5 mx-xl-15 my-7">
                <!--begin::Form-->
                <form id="kt_modal_nursing_home_form" class="form" action="#">
                    <!--begin::Scroll-->
                    <div class="d-flex flex-column me-n7 pe-7">
                        <!--begin::Input group-->
                        <div class="row">
                            <div class="col">
                                <div class="fv-row mb-9">
                                    <!--begin::Input-->
                                    <select name="nursing-home" id="nursing-home" data-control="select2" class="form-select form-select-solid form-select-lg me-4">
                                        <option value="">Alege un camin...</option>
                                    </select>
                                    <!--end::Input-->
                                </div>
                            </div>
                            <div class="col">
                                <div class="mb-9">
                                    <button type="submit" id="nursing_home_form_submit" class="btn btn-primary">
                                        <span class="indicator-label">Aplica</span>
                                        <span class="indicator-progress">Se incarca...
                                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <!--end::Input group-->
                    </div>
                    <!--end::Scroll-->
                </form>
                <!--end::Form-->
                <!--begin::Form-->
                <form id="kt_modal_summary_settings_form" class="form" action="#">
                    <div class="row">
                        <div class="col">
                            <div class="fv-row mb-9" id="summary_settings_floors"></div>
                        </div>
                        <div class="col">
                            <div class="fv-row mb-9" id="summary_settings_shift"></div>
                        </div>
                    </div>
                    <!--begin::Actions-->
                    <div class="text-center pt-15">
                        <input type="hidden" name="nursing-home-location" id="nursing-home-uuid" value="" />
                        <button type="reset" class="btn btn-light me-3" data-kt-summary-settings-modal-action="cancel">Renunta</button>
                        <button type="submit" class="btn btn-primary" data-kt-summary-settings-modal-action="submit" disabled>
                            <span class="indicator-label">Trimite</span>
                            <span class="indicator-progress">Se incarca...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
                        </button>
                    </div>
                    <!--end::Actions-->
                </form>
                <!--end::Form-->
            </div>
            <!--end::Modal body-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>
<!--end::Modal - Summary settings-->