<!--begin::Modal - Cancel viewing-->
<div class="modal fade" id="kt_modal_cancel_viewing" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-600px">
        <!--begin::Modal content-->
        <div class="modal-content">
            <!--begin::Modal header-->
            <div class="modal-header" id="kt_modal_cancel_viewing_header">
                <!--begin::Modal title-->
                <h2 class="fw-bold">Anulare vizita</h2>
                <!--end::Modal title-->
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-kt-cancel-viewing-modal-action="close">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor" />
                        </svg>
                    </span>
                    <!--end::Svg Icon-->
                </div>
                <!--end::Close-->
            </div>
            <!--end::Modal header-->
            <!--begin::Modal body-->
            <div class="modal-body mx-5 mx-xl-15 my-7">
                <!--begin::Form-->
                <form id="kt_modal_cancel_viewing_form" class="form" action="#">
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <p class="fw-semibold fs-6 mb-5">Care este motivul anularii vizitei?</p>
                        <div class="form-check form-check-custom form-check-solid mb-5">
                            <input class="form-check-input" name="option" type="radio" value="Doresc o alta zi in care sa va vizitez" id="reason1" />
                            <label class="form-check-label" for="reason1">
                                Doresc o alta zi in care sa va vizitez
                            </label>
                        </div>
                        <div class="form-check form-check-custom form-check-solid mb-5">
                            <input class="form-check-input" name="option" type="radio" value="Locatia este prea departe" id="reason2" />
                            <label class="form-check-label" for="reason2">
                                Locatia este prea departe
                            </label>
                        </div>
                        <div class="form-check form-check-custom form-check-solid mb-5">
                            <input class="form-check-input" name="option" type="radio" value="Locatia este prea departe" id="reason3" />
                            <label class="form-check-label" for="reason3">
                                Nu sunt de acord ceilalti membri ai familiei
                            </label>
                        </div>
                        <div class="form-check form-check-custom form-check-solid mb-5">
                            <input class="form-check-input" name="option" type="radio" value="Nu ne incadram in buget" id="reason4" />
                            <label class="form-check-label" for="reason4">
                                Nu ne incadram in buget
                            </label>
                        </div>
                        <div class="form-check form-check-custom form-check-solid mb-5">
                            <input class="form-check-input" name="option" type="radio" value="other" id="reason5" />
                            <label class="form-check-label" for="reason5">
                                Alt motiv
                            </label>
                        </div>
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="required fw-semibold fs-6 mb-2">Motiv</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <textarea name="otherReason" id="otherReason" class="form-control form-control-solid mb-3 mb-lg-0" placeholder="Motiv"></textarea>
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Actions-->
                    <div class="text-center pt-15">
                        <input name="reason" type="hidden" value="" id="reason" />
                        <button type="reset" class="btn btn-light me-3" data-kt-cancel-viewing-modal-action="cancel">Renunta</button>
                        <button type="submit" class="btn btn-primary" data-kt-cancel-viewing-modal-action="submit">
                            <span class="indicator-label">Trimite</span>
                            <span class="indicator-progress">Se incarca...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
                        </button>
                    </div>
                    <!--end::Actions-->
                </form>
                <!--end::Form-->
            </div>
            <!--end::Modal body-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>
<!--end::Modal - Cancel viewing-->