<!--begin::Modal - Assign pacient room-->
<div class="modal fade" id="kt_modal_assign_pacient_room" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <!--begin::Modal content-->
        <div class="modal-content">
            <!--begin::Modal header-->
            <div class="modal-header" id="kt_modal_assign_pacient_room_header">
                <!--begin::Modal title-->
                <h2 class="fw-bold">Asociaza camera</h2>
                <!--end::Modal title-->
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-kt-assign-pacient-room-modal-action="close">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor" />
                        </svg>
                    </span>
                    <!--end::Svg Icon-->
                </div>
                <!--end::Close-->
            </div>
            <!--end::Modal header-->
            <!--begin::Modal body-->
            <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                <!--begin::Form-->
                <form id="kt_modal_assign_pacient_room_form" class="form" action="#">
                    <!--begin::Scroll-->
                    <div class="d-flex flex-column scroll-y me-n7 pe-7" id="kt_modal_assign_pacient_room_scroll" data-kt-scroll="true" data-kt-scroll-activate="{default: false, lg: true}" data-kt-scroll-max-height="auto" data-kt-scroll-dependencies="#kt_modal_assign_pacient_room_header" data-kt-scroll-wrappers="#kt_modal_assign_pacient_room_scroll" data-kt-scroll-offset="300px">
                        <!--begin::Input group-->
                        <div class="fv-row mb-7">
                            <!--begin::Label-->
                            <label class="fw-semibold fs-6 mb-2 required">Camin</label>
                            <!--end::Label-->
                            <!--begin::Input-->
                            <select id="nursing_home_location" data-control="select2" data-placeholder="Alege o locatie..." data-dropdown-parent="#kt_modal_assign_pacient_room" name="location" class="form-select form-select-solid form-select-lg fw-semibold" required="required">
                                <option value="">Alege un camin...</option>
                            </select>
                            <!--end::Input-->
                        </div>
                        <!--end::Input group-->
                        <!--begin::Input group-->
                        <div class="fv-row mb-7">
                            <!--begin::Label-->
                            <label class="fw-semibold fs-6 mb-2 required">Camera</label>
                            <!--end::Label-->
                            <!--begin::Input-->
                            <select id="nursing_home_location_room" data-control="select2" data-placeholder="Alege o camera..." name="roomNumber" data-dropdown-parent="#kt_modal_assign_pacient_room" class="form-select form-select-solid form-select-lg fw-semibold" required="required">
                                <option value="">Alege o camera...</option>
                            </select>
                            <!--end::Input-->
                        </div>
                        <!--end::Input group-->
                        <!--begin::Input group-->
                        <div class="fv-row mb-7">
                            <!--begin::Label-->
                            <label class="fw-semibold fs-6 mb-2 required">Data</label>
                            <!--end::Label-->
                            <!--begin::Input-->
                            <input type="text" class="form-control form-control-lg form-control-solid datepicker" name="createdAt" placeholder="Data" value="{{ 'now'|date('Y-m-d') }}" />
                            <!--end::Input-->
                        </div>
                        <!--end::Input group-->
                        <!--begin::Input group-->
                        <div class="fv-row mb-7">
                            <!--begin::Label-->
                            <label class="fw-semibold fs-6 mb-2">Observatii</label>
                            <!--end::Label-->
                            <!--begin::Input-->
                            <textarea name="observations" class="form-control form-control-lg form-control-solid" placeholder="Observatii"></textarea>
                            <!--end::Input-->
                        </div>
                        <!--end::Input group-->
                    </div>
                    <!--end::Scroll-->
                    <!--begin::Actions-->
                    <div class="text-center pt-15">
                        <button type="reset" class="btn btn-light me-3" data-kt-assign-pacient-room-modal-action="cancel">Renunta</button>
                        <button type="submit" class="btn btn-primary" data-kt-assign-pacient-room-modal-action="submit">
                            <span class="indicator-label">Asociaza camera</span>
                            <span class="indicator-progress">Se incarca...
                                <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
                        </button>
                    </div>
                    <!--end::Actions-->
                </form>
                <!--end::Form-->
            </div>
            <!--end::Modal body-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>
<!--end::Modal - Assign pacient room-->