<!--begin::Modal - Add pacient monitoring medical-->
<div class="modal fade" id="kt_modal_add_pacient_monitoring_medical" tabindex="-1" aria-hidden="true">
    <!--begin::Modal dialog-->
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <!--begin::Modal content-->
        <div class="modal-content">
            <!--begin::Modal header-->
            <div class="modal-header border-0 pb-0" id="kt_modal_add_pacient_monitoring_medical_header">
                <!--begin::Modal title-->
                <h2 class="fw-bold">Monitorizare functii vitale</h2>
                <!--end::Modal title-->
                <!--begin::Close-->
                <div class="btn btn-icon btn-sm btn-active-icon-primary" data-kt-add-pacient-monitoring-medical-action="close">
                    <!--begin::Svg Icon | path: icons/duotune/arrows/arr061.svg-->
                    <span class="svg-icon svg-icon-1">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor" />
                            <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor" />
                        </svg>
                    </span>
                    <!--end::Svg Icon-->
                </div>
                <!--end::Close-->
            </div>
            <!--end::Modal header-->
            <!--begin::Modal body-->
            <div class="modal-body scroll-y mx-5 mx-xl-15 my-7">
                <form id="kt_modal_add_pacient_monitoring_medical_form" action="" method="post" class="mw-650px">
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="fw-semibold fs-6 mb-2">Temperatura</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <input type="text" name="temperature" class="form-control form-control-solid mb-3 mb-lg-0" placeholder="Temperatura" />
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="fw-semibold fs-6 mb-2">Saturatie</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <input type="text" name="saturation" class="form-control form-control-solid mb-3 mb-lg-0" placeholder="Saturatie" />
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="fw-semibold fs-6 mb-2">Tensiunea sistolica</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <input type="text" name="systolicBloodPressure" class="form-control form-control-solid mb-3 mb-lg-0" placeholder="Tensiunea sistolica" />
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="fw-semibold fs-6 mb-2">Tensiunea diastolica</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <input type="text" name="diastolicBloodPressure" class="form-control form-control-solid mb-3 mb-lg-0" placeholder="Tensiunea diastolica" />
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="fw-semibold fs-6 mb-2">Puls</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <input type="text" name="heartRate" class="form-control form-control-solid mb-3 mb-lg-0" placeholder="Puls" />
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="fw-semibold fs-6 mb-2">Glicemie</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <input type="text" name="glucose" class="form-control form-control-solid mb-3 mb-lg-0" placeholder="Glicemie" />
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="fw-semibold fs-6 mb-2">Perfuzabile</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <input type="text" name="infusion" class="form-control form-control-solid mb-3 mb-lg-0" placeholder="Perfuzabile" />
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <!--begin::Input group-->
                    <div class="fv-row mb-7">
                        <!--begin::Label-->
                        <label class="fw-semibold fs-6 mb-2">Observatii</label>
                        <!--end::Label-->
                        <!--begin::Input-->
                        <textarea name="observations" class="form-control form-control-solid mb-3 mb-lg-0" rows="3" placeholder="Observatii"></textarea>
                        <!--end::Input-->
                    </div>
                    <!--end::Input group-->
                    <div class="row mt-15 mb-5">
                        <div class="col-lg-12 text-center">
                            <input type="hidden" name="date" id="monitoring_date" value="" />
                            <button type="reset" class="btn btn-light me-3" data-kt-add-pacient-monitoring-medical-action="cancel">Renunta</button>
                            <button type="submit" class="btn btn-primary" data-kt-add-pacient-monitoring-medical-action="submit">
                                <span class="indicator-label">Adauga</span>
                                <span class="indicator-progress">Se incarca...
                                    <span class="spinner-border spinner-border-sm align-middle ms-2"></span></span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <!--end::Modal body-->
        </div>
        <!--end::Modal content-->
    </div>
    <!--end::Modal dialog-->
</div>
<!--begin::Modal - Add pacient monitoring medical-->