                                        <div class="menu-sub menu-sub-lg-down-accordion menu-sub-lg-dropdown menu-active-bg px-lg-2 py-lg-4 w-lg-225px">
                                            {% for template in templates %}
                                                <!--begin:Menu item-->
                                                <div class="menu-item">
                                                    <!--begin:Menu link-->
                                                    <a class="menu-link" href="{{ path('dashboard_document', {'slug': template['slug']}) }}">
                                                        <span class="menu-title">{{ template['name'] }}</span>
                                                    </a>
                                                    <!--end:Menu link-->
                                                </div>
                                                <!--end:Menu item-->
                                            {% endfor %}
                                        </div>
                                        <!--end:Menu sub-->
                                    </div>
                                    <!--end:Menu item-->
                                {% endfor %}
                            </div>
                            <!--end:Menu sub-->
                        </div>
                        <!--end:Menu item-->
