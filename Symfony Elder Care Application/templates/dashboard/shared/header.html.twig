                <div class="menu menu-rounded menu-column menu-lg-row my-5 my-lg-0 align-items-stretch fw-semibold px-2 px-lg-0" id="kt_app_header_menu" data-kt-menu="true">
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_RELATION') %}
                        <!--begin:Menu item-->
                        <div class="menu-item me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
                                <a href="{{ path('dashboard') }}" class="menu-title">Dashboard</a>
                            </span>
                            <!--end:Menu link-->
                        </div>
                        <!--end:Menu item-->
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OWNER') %}
                        <!--begin:Menu item-->
                        <div class="menu-item me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
                                <a href="{{ path('dashboard_nursing_homes') }}" class="menu-title">Unitati</a>
                            </span>
                            <!--end:Menu link-->
                        </div>
                        <!--end:Menu item-->
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OWNER') or is_granted('ROLE_MANAGEMENT') %}
                        <!--begin:Menu item-->
                        <div class="menu-item me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
                                <a href="{{ path('dashboard_users') }}" class="menu-title">Utilizatori</a>
                            </span>
                            <!--end:Menu link-->
                        </div>
                        <!--end:Menu item-->
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OWNER') or is_granted('ROLE_MANAGEMENT') %}
                        <!--begin:Menu item-->
                        <div class="menu-item me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
                                <a href="{{ path('dashboard_pacients_prospects') }}" class="menu-title">Prospecti</a>
                            </span>
                            <!--end:Menu link-->
                        </div>
                        <!--end:Menu item-->
                    {% endif %}

                    {% if not is_granted('ROLE_RELATION') and not is_granted('ROLE_PACIENT') %}
                        <!--begin:Menu item-->
                        <div class="menu-item me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
                                <a href="{{ path('dashboard_pacients') }}" class="menu-title">Pacienti</a>
                            </span>
                            <!--end:Menu link-->
                        </div>
                        <!--end:Menu item-->
                    {% endif %}

                    {% if is_granted('ROLE_MEDIC') %}
