                                    <a class="menu-link" href="{{ path('relations_report') }}">
                                        <span class="menu-title">Apartinatori</span>
                                    </a>
                                    <!--end:Menu link-->
                                </div>
                                <!--end:Menu item-->
                                <!--begin:Menu item-->
                                <div class="menu-item">
                                    <!--begin:Menu link-->
                                    <a class="menu-link" href="{{ path('samples_report') }}">
                                        <span class="menu-title">Recoltare</span>
                                    </a>
                                    <!--end:Menu link-->
