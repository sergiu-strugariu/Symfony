                    <div class="menu-item me-0 me-lg-2">
                        <!--begin:Menu link-->
                        <span class="menu-link">
                            <a href="{{ path('dashboard_summaries') }}" class="menu-title">Borderouri</a>
                        </span>
                        <!--end:Menu link-->
                    </div>
                    <!--end:Menu item-->

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OWNER') or is_granted('ROLE_RECEPTION') or is_granted('ROLE_MANAGEMENT') or is_granted('ROLE_ASSISTANCE_MEDICAL_PHARMACY') or is_granted('ROLE_MEDIC') or is_granted('ROLE_ASSISTANCE_MEDICAL') %}
                        <!--begin:Menu item-->
                        <div class="menu-item me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
