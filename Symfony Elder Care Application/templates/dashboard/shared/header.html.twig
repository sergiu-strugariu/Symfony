                        <div class="menu-item me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
                                <a href="{{ path('diagnoses_treatments_report') }}" class="menu-title">Schema tratament</a>
                            </span>
                            <!--end:Menu link-->
                        </div>
                        <!--end:Menu item-->
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OWNER') or is_granted('ROLE_MANAGEMENT') %}
                        <!--begin:Menu item-->
                        <div data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-placement="bottom-start" class="menu-item menu-lg-down-accordion menu-sub-lg-down-indention me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
                                <span class="menu-title">Divizii</span>
                                <span class="menu-arrow d-lg-none"></span>
                            </span>
                            <!--end:Menu link-->
                            <!--begin:Menu sub-->
                            <div class="menu-sub menu-sub-lg-down-accordion menu-sub-lg-dropdown px-lg-2 py-lg-4 w-lg-200px">
                                <!--begin:Menu item-->
                                <div class="menu-item">
                                    <!--begin:Menu link-->
                                    <a class="menu-link" href="{{ path('dashboard_cook_menus') }}">
                                        <span class="menu-title">Bucatarie</span>
                                    </a>
                                    <!--end:Menu link-->
                                </div>
                                <!--end:Menu item-->
                            </div>
                            <!--end:Menu sub-->
                        </div>
                        <!--end:Menu item-->
                    {% endif %}

                    {#{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OWNER') or is_granted('ROLE_MANAGEMENT') or is_granted('ROLE_RECEPTION') %}
                        <!--begin:Menu item-->
                        <div class="menu-item me-0 me-lg-2">
                            <!--begin:Menu link-->
                            <span class="menu-link">
                                <a href="{{ path('dashboard_documents', {'type': 1}) }}" class="menu-title">Documente</a>
                            </span>
                            <!--end:Menu link-->
                        </div>
                        <!--end:Menu item-->
                    {% endif %}#}

