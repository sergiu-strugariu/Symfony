                                <!--end::Avatar-->
                                <!--begin::Username-->
                                <div class="d-flex flex-column">
                                    <div class="fw-bold d-flex align-items-center fs-5">{{ app.user.name }}
                                        <span class="badge badge-light-success fw-bold fs-8 px-2 py-1 ms-2">{{ app.user.formattedRole }}</span></div>
                                    <a href="#" class="fw-semibold text-muted text-hover-primary fs-7">{{ app.user.email }}</a>
