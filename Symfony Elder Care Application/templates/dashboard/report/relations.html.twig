{% extends 'layout.html.twig' %}

{% block title %}Raport aparținători {{ parent() }}{% endblock %}

{% block toolbar %}
    {% include 'dashboard/shared/toolbar.html.twig' %}
{% endblock %}

{% block content %}
    <!--begin::Card-->
    <div class="card">
        <!--begin::Card body-->
        <div class="card-body py-10 px-10">
            <!--begin::Wrapper-->
            <div class="my-5 d-print-none">
                <div class="d-flex justify-content-between">
                    <!--begin::Form-->
                    <form action="" method="get">
                        <div class="d-flex justify-content-left">
                            <div class="my-2 me-3">
                                <select name="nursing-home" data-control="select2" class="form-select form-select-solid form-select-lg me-4">
                                    <option value="">Alege un cămin</option>
                                    {% for item in nursingHomes %}
                                        <option value="{{ item.uid }}" {{ selectedNursingHome == item.uid ? 'selected' : '' }}>
                                            {{ item.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="my-2">
                                <button type="submit" class="btn btn-primary">Filtrează</button>
                            </div>
                        </div>
                    </form>
                    <!--end::Form-->
                    <div class="my-2">
                        <button type="button" class="btn btn-primary d-inline-block mx-3" onclick="window.print();">
                            Printează
                        </button>
                    </div>

                </div>
            </div>
            <!--end::Wrapper-->
            <div class="my-5">
                <div class="table-responsive">
                    <table class="table table-row-bordered table-row-gray-300 align-middle gs-0 gy-4">
                        <tr>
                            <td class="text-dark fw-bold fs-6">Nr</td>
                            <td class="text-dark fw-bold fs-6">Nume aparținător</td>
                            <td class="text-dark fw-bold fs-6">Adresa de email</td>
                            <td class="text-dark fw-bold fs-6">Telefon</td>
                            <td class="text-dark fw-bold fs-6">Pacient</td>
                            <td class="text-dark fw-bold fs-6">Status</td>
                            <td class="text-dark fw-bold fs-6">Ultima vizita</td>
                            <td class="text-dark fw-bold fs-6">NPS solicitat</td>
                            <td class="text-dark fw-bold fs-6">NPS răspuns</td>
                        </tr>
                        {% for user in relations %}
                            <tr class="hoverable">
                                <td class="fw-semibold fs-6">{{ loop.index }}</td>
                                <td class="fw-semibold fs-6">{{ user['relationName'] }}</td>
                                <td class="fw-semibold fs-6">{{ user['email'] }}</td>
                                <td class="fw-semibold fs-6">{{ user['phoneNumber'] }}</td>
                                <td class="fw-semibold fs-6">{{ user['pacientName'] }}</td>
                                <td class="fw-semibold fs-6">
                                    <span class="badge badge-{{ user['statusClass'] }}" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="{{ 'Data internarii - ' ~ user['pacientData']['admissionDate'] ~ ', Date externarii - ' ~ user['pacientData']['dischargeDate'] ~ ', Motiv externare - ' ~ user['pacientData']['dischargeReason'] }}">
                                        {{ user['status'] }}
                                    </span>
                                </td>
                                <td class="fw-semibold fs-6">{{ user['latestVisit']|time_elapsed }}</td>
                                <td class="fw-semibold fs-6">
                                    {% if user['npsDate'] is empty %}
                                        <div class="show-on-hover invisible">
                                            <a href="#" class="fw-bold text-hover-primary mb-1 fs-6" data-bs-toggle="modal" data-bs-target="#kt_modal_add_nps" data-user-uuid="{{ user['relationUuid'] }}" data-pacient-uuid="{{ user['pacientUuid'] }}">Solicita NPS</a>
                                        </div>
                                    {% else %}
                                        {{ user['npsDate'] }}
                                    {% endif %}
                                </td>
                                <td class="fw-semibold fs-6">
                                    {% if user['npsNote'] is not empty %}
                                        <span class="badge badge-circle {{ badges[user['npsNote']] }}">{{ user['npsNote'] }}</span>
                                    {% endif %}
                                    {% if user['npsFeedback'] is not empty %}
                                        <span class="svg-icon svg-icon-muted svg-icon-2x d-print-none" data-bs-toggle="tooltip" data-bs-custom-class="tooltip-inverse" data-bs-placement="top" title="{{ user['npsFeedback'] }}">
                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="currentColor"/>
                                            <rect x="11" y="14" width="7" height="2" rx="1" transform="rotate(-90 11 14)" fill="currentColor"/>
                                            <rect x="11" y="17" width="2" height="2" rx="1" transform="rotate(-90 11 17)" fill="currentColor"/>
                                            </svg>
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
        </div>
        <!--end::Card body-->
    </div>
    <!--end::Card-->
{% endblock %}

{% block modals %}
    {% include 'dashboard/shared/modal/add_nps.html.twig' %}
{% endblock %}

{% block page_javascripts %}
    <script src="{{ asset('assets/dashboard/plugins/custom/tinymce/tinymce.bundle.js') }}"></script>
    <script>
        // On document ready
        KTUtil.onDOMContentLoaded(function () {
            KTNps.init();
        });
    </script>
{% endblock %}