{% extends 'layout_dashboard.html.twig' %}

{% block title %}{{ parent() }} {{ 'dashboard.my_plan.title'|trans }} {% endblock %}
{% block content %}
    {% set pending = constant('App\\Entity\\Payment::PAYMENT_STATUS_PENDING') %}
    {% set confirmed = constant('App\\Entity\\Payment::PAYMENT_STATUS_CONFIRMED') %}
    <div class="my-plan">
        <div class="inner">
            <div class="content">
                <h3>{{ 'dashboard.my_plan.title'|trans }}</h3>
                <div class="board">
                    <div class="row">
                        <h3>{{ 'dashboard.my_plan.plan_current'|trans }}</h3>
                    </div>
                    <div class="row plan-type">
                        <div class="pack">
                            <div class="img">
                                <img src="{{ asset(app_membership_package_path ~ app.user.membershipPackage.fileName, 'cloudflare') }}"
                                     alt="edit"
                                     width="35"
                                     height="35"
                                />
                            </div>
                            <h4>
                                {{ app.user.membershipPackage.translation(locale).name }}
                            </h4>
                            {% if app.user.paymentToken is not null %}
                                <p class="remove-package-info">
                                    {{ app.user.membershipPackage.price }}
                                    {{ 'company.price_currency'|trans }}
                                    {{ 'dashboard.my_plan.per_month'|trans }}
                                </p>
                                <p class="remove-package-info">
                                    {{ 'dashboard.my_plan.plan_auto_renewal'|trans }}
                                    {{ app.user.membershipExpiresAt|date('d M Y') }}.
                                </p>
                            {% endif %}

                            {% if app.user.membershipExpiresAt is not null and app.user.paymentToken is null %}
                                <p class="remove-package-info">
                                    {{ app.user.membershipPackage.price }}
                                    {{ 'company.price_currency'|trans }}
                                    {{ 'dashboard.my_plan.per_month'|trans }}
                                </p>
                                <p class="remove-package-info">
                                    {{ 'dashboard.my_plan.plan_cancel_renewal'|trans }}
                                    {{ app.user.membershipExpiresAt|date('d M Y') }}.
                                </p>
                            {% endif %}
                        </div>
                        <div class="billing-actions">
                            <a href="{{ path('app_packages') }}">
                                {{ 'dashboard.my_plan.plan_change'|trans }}
                            </a>
                            {% if (app.user.membershipPackage.slug != constant('App\\Entity\\MembershipPackage::PACKAGE_FREE') and app.user.paymentToken is not null) %}
                                <a href="#" class="bg-danger" id="remove-package"
                                   data-package="{{ app.user.membershipPackage.translation(locale).name }}">
                                    {{ 'dashboard.my_plan.plan_cancel'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                    <div class="row plan-type">
                        <div class="pack">
                            <h4>{{ 'dashboard.my_plan.plan_info'|trans }}</h4>
                            <p>
                                <strong>{{ 'common.filter_name'|trans }}:</strong>
                                <span class="plan-name">
                                    {{ favoriteCompany is not null ? favoriteCompany.companyName : '' }}
                                </span>
                            </p>
                            <p>
                                <strong>{{ 'dashboard.my_plan.plan_billing_address'|trans }}:</strong>
                                <span class="plan-address">
                                    {% if(favoriteCompany is not null) %}
                                        {{ favoriteCompany.address }},
                                        {{ favoriteCompany.county.name }},
                                        {{ favoriteCompany.city.name }}
                                    {% endif %}
                                 </span>
                            </p>
                        </div>
                    </div>
                    {% if invoices is not empty %}
                        <div class="row">
                            <div class="pack">
                                <h4>{{ 'dashboard.my_plan.plan_billing_history'|trans }}</h4>
                                <ul class="billing-history">
                                    {% for invoice in invoices %}
                                        <li>
                                            <p>{{ invoice.membershipPackage.translation(locale).name }}</p>
                                            <p>{{ invoice.price }} {{ 'company.price_currency'|trans }}</p>
                                            <p>
                                                {% set badgeClass = invoice.status == pending ? 'badge-warning' : (invoice.status == confirmed ? 'badge-success' : 'badge-danger') %}
                                                <span class="badge {{ badgeClass }}">{{ invoice.status }}</span>
                                            </p>
                                            <p>{{ invoice.updatedAt|date('d M. Y H:i') }}</p>
                                            <a href="{{ path('app_payment_invoice', {'uuid': invoice.uuid}) }}" class="{{ invoice.status != confirmed ? 'disabled' : '' }}">
                                                {{ 'common.view_more'|trans }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                                <div class="billing-actions load-more">
                                    <a href="#" class="view-more">{{ 'common.see_more_results'|trans }}</a>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
                <div class="board has-loader">
                    <div class="row">
                        <div class="pack-billing">
                            <h3>{{ 'dashboard.common.billing_data'|trans }}</h3>
                            <div class="billing-data">
                                <div class="radio-btn-group" id="radioBtnGroup">
                                    {% for company in companies %}
                                        <div class="radio-group {{ company.favorite ? 'checked-input' : '' }}"
                                             data-index="{{ company.uuid }}">
                                            <div class="radio-content">
                                                <input type="radio" id="{{ company.uuid }}"
                                                       name="billingDetails"
                                                       value="{{ company.uuid }}"
                                                       required="required"
                                                        {{ company.favorite ? 'checked' : '' }}
                                                       data-favorite="{{ company.favorite ? 1 : 0 }}"
                                                />
                                                <label for="{{ company.uuid }}">
                                                    {{ company.companyName }}
                                                    <span>
                                                        {{ company.address }},
                                                        {{ company.county.name }},
                                                        {{ company.city.name }}
                                                    </span>
                                                </label>
                                            </div>
                                            <div class="button-wrapper">
                                                <a href="#" class="modify-company" data-index="{{ company.uuid }}">
                                                    {{ 'dashboard.common.modify'|trans }}
                                                </a>
                                                <a href="#" class="delete-company" data-index="{{ company.uuid }}">
                                                    {{ 'dashboard.common.delete'|trans }}
                                                </a>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                <a href="#" class="add-new-company" data-bs-toggle="modal" data-bs-target="#modalAddCompany">
                                    <span>＋</span>
                                    {{ 'dashboard.my_plan.plan_billing_address_add_new'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Start: Modal for changing billing -->
        {% include "frontend/pages/package-order/modal-add-company.html.twig" %}
        <!-- End: Modal for changing billing -->
    </div>
{% endblock %}
{% block page_javascripts %}
    <script src="{{ asset('assets/dashboard/js/profile/myPlan.js') }}"></script>
    <script src="{{ asset('assets/dashboard/js/profile/formMessageHelper.js') }}"></script>
    <script src="{{ asset('assets/dashboard/js/profile/validationHelper.js') }}"></script>
    <script src="{{ asset('assets/dashboard/js/profile/orderDetails.js') }}"></script>
{% endblock %}
