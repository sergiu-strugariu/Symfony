{% extends 'layout-email.html.twig' %}

{% block title %}{{ parent() }} {{ pageTitle }}{% endblock %}
{% block content %}
    {% set phone = settingService.getService('phone') %}
    {% set email = settingService.getService('email') %}
    <tr>
        <td style="padding: 0">
            <img src="{{ absolute_url(asset('assets/frontend/images/email/email_intro_shelter.webp')) }}" alt="email_intro_shelter" style="width: 100%; max-width: 650px; height: auto; display: block;" />
        </td>
    </tr>
    <tr>
        <td style="text-align: center;padding: 0">
            <h1 style="padding: 20px 0; color: #1B3A4F;">
                {{ 'email.payment.confirm_order'|trans }}
            </h1>
            <p style="text-align: left">
                {{ 'email.payment.confirm_message'|trans }}
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding: 18px 30px;">
            <table style="background-color: #E0F7FF">
                <tr>
                    <td>
                        <p style="padding: 32px 10px 20px;font-weight: bold; text-align: left">{{ 'packages.command_details'|trans }}:</p>
                    </td>
                </tr>
                <tr>
                    <td style="text-align: left; padding: 0 10px 30px 10px; display: block;">
                        <p style="text-align: left;max-width: 560px;">
                            {{ 'email.payment.number_order'|trans }}: {{ payment.uuid }}
                        </p>
                        <p style="text-align: left;max-width: 560px;">
                            {{ 'email.payment.date_order'|trans }}: {{ payment.createdAt|date('d/m/Y') }}
                        </p>
                        <p style="text-align: left;max-width: 560px;">
                            {{ 'email.payment.product_name'|trans }}: {{ payment.membershipPackage.translation(locale).name }}
                        </p>
                        <p style="text-align: left;max-width: 560px;">
                            {{ 'common.filter_price'|trans }}: {{ payment.price }} {{ 'company.price_currency'|trans }}
                        </p>
                        <p style="text-align: left;max-width: 560px;">
                            {{ 'email.payment.start_date'|trans }}: {{ payment.updatedAt|date('d/m/Y') }}
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td style="padding: 25px 10px;">
            <a href="{{ absolute_url(path('app_register_form', {'type': 'company'})) }}" target="_blank" style="display:block;">
                <img src="{{ absolute_url(asset('assets/frontend/images/email/create-account-comapny.webp')) }}" alt="footer-image" style="width: 100%; max-width: 590px; display: block" />
            </a>
        </td>
    </tr>
    <tr>
        <td style="padding: 50px 10px 0 10px;">
            <p style="padding: 18px 0; display: block;"> {{ 'email.reset_password.general_info'|trans }}
                <a href="mailto:{{ email }}" style="text-decoration: underline;display: inline;">
                    {{ email }}
                </a>
                {{ 'email.reset_password.or'|trans }}
                <a href="tel:{{ phone }}" style="display: inline; text-decoration: none;">
                    {{ phone }}
                </a>
            </p>
        </td>
    </tr>
    <tr>
        <td style="padding: 50px 10px 50px 10px; text-align: left">
            <p>{{ 'email.common.with_respect'|trans }},</p>
            <p>{{ 'email.common.team'|trans }} {{ app_name }}</p>
        </td>
    </tr>
{% endblock %}
