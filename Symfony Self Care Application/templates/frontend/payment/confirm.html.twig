{% extends 'layout.html.twig' %}

{% block title %}{{ parent() }} Confirm{% endblock %}
{% block content %}
    <main class="order-status">
        <div class="inner">
            <div class="content {{ error ? 'order-error' : '' }}">
                <div class="text-area">
                    <h1>{{ title }}</h1>
                    <p>{{ subtitle }}</p>
                    <div class="cta-resources">
                        <a href="{{ error ? path('app_packages') : path('app_homepage') }}">{{ error ? 'Alege pachetul dorit' : 'INAPOI LA HOMEPAGE' }}</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="image" data-image="{{ asset('assets/frontend/images/homepage/intro_home_cauta.webp') }}"></div>
    </main>
{% endblock %}