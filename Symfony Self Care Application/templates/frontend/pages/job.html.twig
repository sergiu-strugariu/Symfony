{% extends 'layout.html.twig' %}

{% block title %}{{ parent() }} {{ job.translation(locale).title }}{% endblock %}
    {% block share %}
        <meta property="og:title" content="{{ job.translation(locale).title }}"/>
        <meta property="og:description" content="{{ job.translation(locale).shortDescription }}"/>
        <meta property="og:type" content="website"/>
        <meta property="og:url" content=""/>
        <meta property="og:image" content="{{ asset(app_course_path ~ job.fileName, 'cloudflare') }}"/>
        <meta property="og:image:width" content="1200"/>
        <meta property="og:image:height" content="630"/>
    {% endblock %}
{% block content %}
    <main class="job-details">
        <div class="inner">
            <!-- start::Breadcrumb -->
            {% include "shared/frontend/common/breadcrumbs.html.twig" %}
            <!-- end::Breadcrumb -->

            <!-- start::Intro -->
            {% include "frontend/pages/job/single/intro.html.twig" %}
            <!-- end::Intro -->

            <!-- start::Info -->
            {% include "frontend/pages/job/single/info.html.twig" %}
            <!-- end::Info -->

            <!-- start::Description -->
            {% include "frontend/pages/job/single/description.html.twig" %}
            <!-- end::Description -->

            <!-- start::Form & Share -->
            {% include "frontend/pages/job/single/form.html.twig" %}
            <!-- end::Form & Share -->

            <!-- start::Recommended jobs-->
            {% include "frontend/pages/common/recomended-jobs.html.twig" with {
                'sectionTitle': 'jobs.recommended_job_section'|trans,
                'recommended': jobRecommended
            } %}
            <!-- end::Recommended jobs-->

            <!-- start::Recommended courses -->
            {% include "frontend/pages/common/recomended-courses.html.twig" %}
            <!-- end::Recommended courses -->
        </div>
    </main>
{% endblock %}