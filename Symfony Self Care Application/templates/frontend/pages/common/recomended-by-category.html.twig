{% if (categoryRecommended is not empty) %}
    <div class="recommended-resources">
        <div class="inner">
            <h2>
                {{ 'homepage.recommended_by_category'|trans }}
                <span>&bdquo;</span>
                {{ category.translation(locale).title }}
                <span>&rdquo;</span>
            </h2>
            <div class="list">
                {% for item in categoryRecommended %}
                    <a href="{{ path(singlePath, {'slug': item.slug}) }}" class="card">
                        <div class="card-inner">
                            <div class="image" style="background-image: url('{{ asset(app_company_path ~ item.fileName, 'cloudflare') }}')"></div>
                            <div class="image-content">
                                <div class="card-overlay"></div>
                                <h3>{{ item.name }}</h3>
                                <p>{{ item.county }}, {{ item.city }}</p>
                                {% if item.averageRating is not null %}
                                    <span>
                                    {{ item.averageRating }}
                                    <img src="{{ asset('assets/frontend/images/common/star.png') }}" alt="rating-star"/>
                                </span>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
        <div class="cta-resources">
            <a href="{{ path(listingPath, {'category': category.slug}) }}">
                {{ 'common.view_more_hostels'|trans }}
            </a>
        </div>
    </div>
{% endif %}
