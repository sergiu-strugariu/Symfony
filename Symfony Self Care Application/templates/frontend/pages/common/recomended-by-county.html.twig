{% if (countyRecommended is not empty) %}
    <div class="slider-filter-anchor slick-shelters-anchor">
        <div class="inner">
            <h2>
                {{ 'company.other_hostels'|trans }}
                <span>&bdquo;</span>
                {{ county.name }}
                <span>&rdquo;</span>
            </h2>
            <div class="list-wrapper recommended-resources">
                <div class="slick-shelters has-loader">
                    {% for item in countyRecommended %}
                        <div class="shelter">
                            <div class="shelter-overlay"></div>
                            <div class="image" style="background-image: url('{{ asset(app_company_path ~ item.fileName, 'cloudflare') }}')">
                                <a href="{{ path(singlePath, {'slug': item.slug}) }}" class="details-link">
                                    {{ 'common.view_more'|trans }}
                                </a>
                            </div>
                            <div class="image-content">
                                <h3>{{ item.name }}</h3>
                                <p>{{ item.county }}, {{ item.city }}</p>
                                {% if item.averageRating is not null %}
                                    <span>
                                    {{ item.averageRating }}
                                    <img src="{{ asset('assets/frontend/images/common/star.png') }}" alt="rating-star"/>
                                </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="cta-resources">
                <a href="{{ path(listingPath, {'county': county.code}) }}">
                    {{ 'common.view_more_hostels'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endif %}
