{% extends 'layout.html.twig' %}

{% block title %}{{ parent() }} {{ course.translation(locale).title }}{% endblock %}
    {% block share %}
        <meta property="og:title" content="{{ course.translation(locale).title }}"/>
        <meta property="og:description" content="{{ course.translation(locale).shortDescription }}"/>
        <meta property="og:type" content="website"/>
        <meta property="og:url" content=""/>
        <meta property="og:image" content="{{ asset(app_course_path ~ course.fileName, 'cloudflare') }}"/>
        <meta property="og:image:width" content="1200"/>
        <meta property="og:image:height" content="630"/>
    {% endblock %}
{% block content %}
    <main class="courses-forming-details">
        <div class="inner">
            <!-- start::Breadcrumb -->
            {% include "shared/frontend/common/breadcrumbs.html.twig" %}
            <!-- end::Breadcrumb -->

            <!-- start::Content -->
            {% include "frontend/pages/course/single/content.html.twig" %}
            <!-- end::Content -->

            <!-- start::Form -->
            {% include "frontend/pages/course/single/form.html.twig" %}
            <!-- end::Form -->

            <!-- start::Recommended courses -->
            {% include "frontend/pages/common/recomended-courses.html.twig" %}
            <!-- end::Recommended courses -->

            <!-- start::Recommended jobs-->
            {% include "frontend/pages/common/recomended-jobs.html.twig" with {
                'sectionTitle': 'jobs.recommended_job_section'|trans,
                'recommended': jobRecommended
            } %}
            <!-- end::Recommended jobs-->
        </div>
    </main>
{% endblock %}