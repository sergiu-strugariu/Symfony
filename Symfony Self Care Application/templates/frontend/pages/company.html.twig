{% extends 'layout.html.twig' %}

{% block title %}{{ parent() }} {{ company.name }}{% endblock %}
    {% block share %}
        <meta property="og:title" content="{{ company.name }}"/>
        <meta property="og:description" content="{{ company.shortDescription }}"/>
        <meta property="og:type" content="website"/>
        <meta property="og:url" content=""/>
        <meta property="og:image" content="{{ asset(app_company_path ~ company.fileName, 'cloudflare') }}"/>
        <meta property="og:image:width" content="1200"/>
        <meta property="og:image:height" content="630"/>
    {% endblock %}
{% block content %}
    <main class="home-details">
        <div class="home-details__wrapper inner">
            <!-- start::Breadcrumb -->
            {% include "shared/frontend/common/breadcrumbs.html.twig" %}
            <!-- end::Breadcrumb -->

            <!-- start::Intro -->
            {% include "frontend/pages/company/single/intro.html.twig" %}
            <!-- end::Intro -->

            <!-- start::Content -->
            {% include "frontend/pages/company/single/content.html.twig" %}
            <!-- end::Content -->

            <!-- start::Reviews -->
            {% include "frontend/pages/company/single/reviews.html.twig" %}
            <!-- end::Reviews -->

            <!-- start::Recommended county -->
            {% include "frontend/pages/common/recomended-company.html.twig" with {
                'recommended': countyRecommended,
                'singlePath': 'app_company_single',
                'listingPath': 'app_company',
                'sectionName': 'company.other_hostels'|trans,
                'sectionTitle': company.county.name,
                'filterParam': {'county': company.county.code}
            } %}
            <!-- end::Recommended county -->

            <!-- start::Recommended category -->
            {% include "frontend/pages/common/recomended-company.html.twig" with {
                'recommended': categoryRecommended,
                'singlePath': 'app_company_single',
                'listingPath': 'app_company',
                'sectionName': 'homepage.company_by_category'|trans,
                'sectionTitle': category.translation(locale).title,
                'filterParam': {'category': category.slug}
            } %}
            <!-- end::Recommended category -->

            <!-- start::Care jobs-->
            {% include "frontend/pages/common/recomended-jobs.html.twig" with {
                'sectionTitle': 'company.care_jobs'|trans,
                'recommended': jobs
            } %}
            <!-- end::Care jobs-->
        </div>
    </main>
{% endblock %}